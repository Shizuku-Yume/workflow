#!/usr/bin/env bash
# workflow-decisions - inspect and repair the project decision log
set -euo pipefail

usage() {
  cat <<'EOF'
workflow decisions - search and manage the decision log

Usage:
  workflow decisions [list] [OPTIONS]
  workflow decisions search TERM [OPTIONS]
  workflow decisions recent [N] [OPTIONS]
  workflow decisions validate [OPTIONS]
  workflow decisions --fix [--apply] [--format json]

Options:
  --after DATE        Include decisions on or after DATE
  --before DATE       Include decisions on or before DATE
  --field FIELD       Search only Decided, Instead of, Because, Mine,
                      Revisit when, Effort, Date, or Title
                      (case-insensitive names)
  --effort SLUG       Include only entries tagged **Effort:** SLUG
  --format FORMAT     text (default) or json
  --fix               Preview safe formatting repairs; never invent content
  --apply             Write repairs (requires --fix)
  --no-color          Disable ANSI colors
  -h, --help          Show help

Search is a case-insensitive literal substring search. Quote multiword terms
and field names. Results use newest log-entry order, with recent defaulting
to 10 entries. JSON listing/search output is an array of decision objects;
validation and repair output is a report object. Warnings go to stderr.

Entries may carry an optional `**Effort:** <slug>` tag; `--effort` filters by
it and `--field Effort` searches it. Absent tags are fine; a present tag must
be a lowercase slug.

Dates accept YYYY-MM-DD or ISO-8601 timestamps with optional fractional
seconds and Z or +/-HH:MM offsets. Timestamps without offsets use UTC.
Date-only --before includes the entire day; bounds are inclusive. Entries
without usable dates are warned about and skipped when date filters are used.

Canonical logs have dated level-2 headings under ## Entries. Legacy
Decided-delimited lists are also supported (Date fields or leading ISO dates
in Decided supply their dates). Multiline field contents are retained.

Examples:
  workflow decisions search auth --field Because
  workflow decisions search "exponential backoff"
  workflow decisions --effort api-v2 --format json
  workflow decisions --after 2026-01-01 --before 2026-01-31 --format json
  workflow decisions recent 5 --no-color
  workflow decisions validate
  workflow decisions --fix              # preview only
  workflow decisions --fix --apply      # normalize field labels/indentation

Exit codes: 0 success, 1 file/validation error, 2 invalid usage.
EOF
}
error() { printf 'Error: %s\n' "$*" >&2; }
usage_error() { error "$*"; exit 2; }

# Help remains usable without a project and even alongside incomplete arguments.
for arg in "$@"; do
  case "$arg" in -h|--help) usage; exit 0 ;; esac
done

command=list
command_seen=0
format=text
field=
effort_filter=
after=
before=
no_color=0
fix=0
apply=0
positionals=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --after|--before|--field|--format|--effort)
      [ "$#" -ge 2 ] && [ -n "$2" ] && [[ "$2" != --* ]] || usage_error "$1 requires a value"
      case "$1" in
        --after) after="$2" ;;
        --before) before="$2" ;;
        --field) field="$2" ;;
        --effort) effort_filter="$2" ;;
        --format) format="$2" ;;
      esac
      shift 2 ;;
    --no-color) no_color=1; shift ;;
    --fix) fix=1; shift ;;
    --apply) apply=1; shift ;;
    --) shift; positionals+=("$@"); break ;;
    -*) usage_error "unknown option: $1" ;;
    *)
      if [ "$command_seen" -eq 0 ]; then
        case "$1" in list|search|recent|validate) command="$1" ;; help) usage; exit 0 ;; *) usage_error "unknown command: $1" ;; esac
        command_seen=1
      else
        positionals+=("$1")
      fi
      shift ;;
  esac
done
case "$format" in text|json) ;; *) usage_error '--format must be text or json' ;; esac
term=
limit=0
case "$command" in
  search)
    [ "${#positionals[@]}" -eq 1 ] && [ -n "${positionals[0]}" ] || usage_error 'search requires one term (quote multiword searches)'
    term="${positionals[0]}" ;;
  recent)
    [ "${#positionals[@]}" -le 1 ] || usage_error 'recent accepts only one count'
    limit="${positionals[0]:-10}"
    [[ "$limit" =~ ^[0-9]+$ ]] && [[ "$limit" =~ [1-9] ]] && [ "${#limit}" -le 9 ] || usage_error 'recent count must be a positive integer (at most 9 digits)' ;;
  *) [ "${#positionals[@]}" -eq 0 ] || usage_error "$command does not accept positional arguments" ;;
esac
[ -z "$field" ] || [ "$command" = search ] || usage_error '--field requires search'
[ "$apply" -eq 0 ] || [ "$fix" -eq 1 ] || usage_error '--apply requires --fix'
if [ "$fix" -eq 1 ]; then
  case "$command" in list|validate) ;; *) usage_error '--fix cannot be combined with search or recent' ;; esac
  [ -z "$after$before$field$effort_filter" ] || usage_error '--fix cannot be combined with filters'
fi

color=0
if [ -t 1 ] && [ "$no_color" -eq 0 ] && [ -z "${NO_COLOR:-}" ]; then color=1; fi
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
DECISIONS_FILE="$ROOT/.workflow/decisions.md"
file_exists=0
if [ -f "$DECISIONS_FILE" ]; then file_exists=1; fi
export WD_FILE_EXISTS="$file_exists"

# Pass strings through ENVIRON rather than awk -v, which interprets escapes in
# user search terms. One log read supports both historical and current formats.
export WD_COMMAND="$command" WD_FORMAT="$format" WD_FIELD="$field"
export WD_AFTER="$after" WD_BEFORE="$before" WD_TERM="$term" WD_EFFORT="$effort_filter"
export WD_LIMIT="$limit" WD_FIX="$fix" WD_APPLY="$apply" WD_COLOR="$color"
export WD_FILE="$DECISIONS_FILE"
repair_file=
cleanup() { if [ -n "$repair_file" ]; then rm -f -- "$repair_file"; fi; }
trap cleanup EXIT
if [ "$fix" -eq 1 ]; then
  if [ ! -f "$DECISIONS_FILE" ]; then error "No decisions file: $DECISIONS_FILE"; exit 1; fi
  repair_target="$DECISIONS_FILE"
  # Resolve a log symlink before replacing its target, leaving the link intact.
  while [ -L "$repair_target" ]; do
    link_target="$(readlink "$repair_target")" || { error "cannot resolve $repair_target"; exit 1; }
    case "$link_target" in
      /*) repair_target="$link_target" ;;
      *) repair_target="$(dirname "$repair_target")/$link_target" ;;
    esac
  done
  repair_file="$(mktemp "$(dirname "$repair_target")/.decisions-repair.XXXXXX")" || { error 'cannot create repair file'; exit 1; }
  if [ "$apply" -eq 1 ]; then
    [ -w "$repair_target" ] || { error "cannot write $repair_target"; exit 1; }
    cp -p "$repair_target" "$repair_file" || { error 'cannot preserve decision log permissions'; exit 1; }
    : > "$repair_file"
  fi
fi
export WD_REPAIR_FILE="$repair_file"

# Opening the log inside awk lets usage/date validation happen even if it is
# missing, and reports unreadable input instead of exposing a shell crash.
awk '
function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
function fail(s) { print "Error: " s > "/dev/stderr"; fatal=1; exit 2 }
function warning(line, s) {
  print "Warning: line " line ": " s > "/dev/stderr"
  warnings++
}
function key(s, t) {
  t=tolower(trim(s)); gsub(/[[:space:]]+/, " ", t)
  if (t=="decided") return "Decided"
  if (t=="instead of") return "Instead of"
  if (t=="because") return "Because"
  if (t=="mine") return "Mine"
  if (t=="revisit when") return "Revisit when"
  if (t=="effort") return "Effort"
  if (t=="date") return "Date"
  if (t=="title") return "Title"
  return ""
}
function leap(y) { return y%4==0 && (y%100!=0 || y%400==0) }
# Gregorian civil date to epoch days (independent of host date implementation).
function days(y,m,d, era,yo,mp,dy,de) {
  y-=m<=2; era=int(y/400); yo=y-era*400; mp=m+(m>2 ? -3 : 9)
  dy=int((153*mp+2)/5)+d-1; de=yo*365+int(yo/4)-int(yo/100)+dy
  return era*146097+de-719468
}
function iso(s, y,m,d,maxd,rest,offset,sign,h,mi,se,fraction,p,zone) {
  date_ok=0; date_only=0
  if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) return 0
  y=substr(s,1,4)+0; m=substr(s,6,2)+0; d=substr(s,9,2)+0
  if (y<1 || m<1 || m>12) return 0
  maxd=31
  if (m==4 || m==6 || m==9 || m==11) maxd=30
  if (m==2) maxd=28+leap(y)
  if (d<1 || d>maxd) return 0
  rest=substr(s,11); offset=0; h=0; mi=0; se=0; fraction=0
  if (rest=="") date_only=1
  else {
    if (rest !~ /^T[0-9][0-9]:[0-9][0-9]/) return 0
    h=substr(rest,2,2)+0; mi=substr(rest,5,2)+0; rest=substr(rest,7)
    if (substr(rest,1,1)==":") {
      if (rest !~ /^:[0-9][0-9]/) return 0
      se=substr(rest,2,2)+0; rest=substr(rest,4)
      if (substr(rest,1,1)==".") {
        if (!match(rest,/^\.[0-9]+/)) return 0
        fraction=substr(rest,1,RLENGTH)+0; rest=substr(rest,RLENGTH+1)
      }
    }
    if (h>23 || mi>59 || se>59) return 0
    if (rest=="Z" || rest=="") offset=0
    else {
      if (rest !~ /^[+-][0-9][0-9]:[0-9][0-9]$/) return 0
      sign=substr(rest,1,1)=="+" ? 1 : -1
      hzone=substr(rest,2,2)+0; mzone=substr(rest,5,2)+0
      if (hzone>23 || mzone>59) return 0
      offset=sign*(hzone*3600+mzone*60)
    }
  }
  date_ok=1
  return days(y,m,d)*86400+h*3600+mi*60+se+fraction-offset
}
function date_prefix(s, token) {
  token=s; sub(/[[:space:]].*$/, "", token); sub(/[),;]$/, "", token)
  iso(token); return date_ok ? token : ""
}
function start(title,date,heading) {
  count++; entry_line[count]=line_no; entry_title[count]=title
  entry_date[count]=date; is_heading[count]=heading; current=""
}
function append(s) {
  if (current!="") {
    s=trim(s)
    values[count,current]=values[count,current] "\n" s
  }
}
# Accept normal labels and safely repairable alternatives such as **Because**:
# or plain Because:. Unknown bullets remain content, never implicit fields.
function field_line(s, t,label,pos) {
  parsed_key=""; parsed_value=""; canonical_line=""
  t=trim(s)
  if (t !~ /^[-*+][[:space:]]+/) return 0
  sub(/^[-*+][[:space:]]+/, "", t)
  if (substr(t,1,2)=="**") {
    t=substr(t,3); pos=index(t,"**")
    if (!pos) return 0
    label=substr(t,1,pos-1); t=substr(t,pos+2)
    if (substr(label,length(label),1)==":") label=substr(label,1,length(label)-1)
    else { if (substr(t,1,1)!=":") return 0; t=substr(t,2) }
  } else {
    pos=index(t,":"); if (!pos) return 0
    label=substr(t,1,pos-1); t=substr(t,pos+1)
  }
  parsed_key=key(label)
  if (parsed_key=="" || parsed_key=="Title") return 0
  parsed_value=trim(t)
  canonical_line="- **" parsed_key ":**" (parsed_value!="" ? " " parsed_value : "")
  return 1
}
function process(s, h,d,pos,t,active,found,closepos,runlength) {
  # Skip HTML comments, including inline comments, and fenced Markdown examples.
  active=s
  t=trim(active)
  if (fence!="") {
    if (substr(t,1,1)==fence_char && match(t,/^(``[`]+|~~~[~]*)/)) {
      runlength=RLENGTH
      if (runlength>=fence_length && trim(substr(t,runlength+1))=="") { fence="" }
    }
    return
  }
  if (comment) {
    pos=index(active,"-->")
    if (!pos) return
    active=substr(active,pos+3); comment=0
  }
  while ((pos=index(active,"<!--"))>0) {
    t=substr(active,pos+4); closepos=index(t,"-->")
    if (!closepos) { active=substr(active,1,pos-1); comment=1; break }
    active=substr(active,1,pos-1) substr(t,closepos+3)
  }
  t=trim(active)
  if (match(t,/^(``[`]+|~~~[~]*)/)) {
    fence=substr(t,1,RLENGTH); fence_char=substr(fence,1,1); fence_length=length(fence); return
  }
  h=""
  if (active ~ /^ ? ? ?##[[:space:]]+/) {
    h=active; sub(/^ ? ? ?##[[:space:]]+/, "", h); h=trim(h)
  }
  if (scan_only) {
    if (tolower(h)=="entries") has_entries_marker=1
    return
  }
  if (has_entries_marker && !entries_section && tolower(h)!="entries") return
  if (active ~ /^ ? ? ?##[[:space:]]+/) {
    if (tolower(h)=="entries") { entries_section=1; current=""; heading_active=0; return }
    d=h; sub(/[[:space:]].*$/, "", d)
    if (d ~ /^[0-9][0-9][0-9][0-9]-/) {
      t=trim(substr(h,length(d)+1)); sub(/^[-–—][[:space:]]*/, "", t)
      start(t,d,1); heading_active=1; entries_section=1; return
    }
    if (entries_section) {
      start(h,"",1); heading_active=1
      warning(line_no,"entry heading has no ISO-8601 date")
    } else { current=""; heading_active=0 }
    return
  }
  if (active ~ /^ ? ? ?#[[:space:]]/) { current=""; heading_active=0; return }
  found=field_line(active)
  if (found && parsed_key=="Decided" && !heading_active && active ~ /^[-*+][[:space:]]/) {
    start("",date_prefix(parsed_value),0); entries_section=1
  }
  if (found && count>0) {
    if (seen[count,parsed_key]) {
      warning(line_no,"duplicate " parsed_key " field; retaining both values")
      values[count,parsed_key]=values[count,parsed_key] "\n" parsed_value
      invalid[count]=1
    } else values[count,parsed_key]=parsed_value
    seen[count,parsed_key]=1; current=parsed_key
    if (parsed_key=="Date") entry_date[count]=parsed_value
    # Indentation is retained for legacy fields; heading-based fields are flat.
    t=canonical_line
    if (!is_heading[count] && parsed_key!="Decided") t="  " t
    if (active==s && t!=s) {
      repair_line[line_no]=t (originals[line_no] ~ /\r$/ ? "\r" : ""); repairs++
      if (!fix) warning(line_no,"noncanonical field formatting (preview repairs with --fix)")
    }
    return
  }
  if (found && count==0) {
    warning(line_no,"orphan " parsed_key " field before a decision; skipped"); return
  }
  # A continuation ends at a blank line followed by unindented prose. Keep
  # indented paragraphs, nested lists and ### subsections within the field.
  if (current!="" && (active ~ /^[[:space:]]/ || active ~ /^###/)) append(active)
  else if (trim(active)=="" && current!="") append("")
  else current=""
}
function json(s, out,c,j) {
  out="\""
  for (j=1;j<=length(s);j++) {
    c=substr(s,j,1)
    if (c=="\\") out=out "\\\\"
    else if (c=="\"") out=out "\\\""
    else if (c=="\n") out=out "\\n"
    else if (c=="\r") out=out "\\r"
    else if (c=="\t") out=out "\\t"
    else if (c in controls) out=out sprintf("\\u%04x",controls[c])
    else out=out c
  }
  return out "\""
}
function object(i, j,k) {
  printf "{\"id\":%d,\"line\":%d,\"date\":%s,\"title\":%s,\"fields\":{", i,entry_line[i],(entry_date[i]!="" ? json(entry_date[i]) : "null"),json(entry_title[i])
  for (j=1;j<=5;j++) { k=fields[j]; printf "%s%s:%s",(j>1 ? "," : ""),json(k),json(values[i,k]) }
  if (values[i,"Effort"]!="") printf ",\"Effort\":%s",json(values[i,"Effort"])
  printf "}}"
}
function text(i, j,k,s,lines,n,l) {
  printf "%s%d.%s %s%s\n", bold,i,off,(entry_date[i]!="" ? entry_date[i] " - " : ""),(entry_title[i]!="" ? entry_title[i] : values[i,"Decided"])
  for (j=1;j<=5;j++) {
    k=fields[j]; s=values[i,k]
    if (s=="" || (k=="Decided" && entry_title[i]=="")) continue
    n=split(s,lines,"\n"); printf "   %s%s: %s%s\n",dim,k,lines[1],off
    for (l=2;l<=n;l++) printf "      %s%s%s\n",dim,lines[l],off
  }
  if (values[i,"Effort"]!="") printf "   %sEffort: %s%s\n",dim,values[i,"Effort"],off
  print ""
}
function validate(i,j,k,d) {
  for (i=1;i<=count;i++) {
    for (j=1;j<=5;j++) {
      k=fields[j]; values[i,k]=trim(values[i,k])
      if (values[i,k]=="") { warning(entry_line[i],"missing or empty " k " field"); invalid[i]=1 }
    }
    if (entry_date[i]!="") {
      epoch[i]=iso(entry_date[i]); has_date[i]=date_ok
      if (!date_ok) { warning(entry_line[i],"invalid ISO-8601 date: " entry_date[i]); invalid[i]=1 }
    } else if (is_heading[i]) invalid[i]=1
    if ((after!="" || before!="") && !has_date[i]) warning(entry_line[i],"no usable date; skipped by date filters")
    values[i,"Effort"]=trim(values[i,"Effort"])
    if (values[i,"Effort"]!="" && values[i,"Effort"] !~ /^[a-z0-9]+(-[a-z0-9]+)*$/) { warning(entry_line[i],"invalid Effort tag: " values[i,"Effort"]); invalid[i]=1 }
    if (invalid[i]) errors++
  }
}
BEGIN {
  command=ENVIRON["WD_COMMAND"]; format=ENVIRON["WD_FORMAT"]
  after=ENVIRON["WD_AFTER"]; before=ENVIRON["WD_BEFORE"]; effort_filter=ENVIRON["WD_EFFORT"]
  term=tolower(ENVIRON["WD_TERM"]); search_field=ENVIRON["WD_FIELD"]
  limit=ENVIRON["WD_LIMIT"]+0; fix=ENVIRON["WD_FIX"]+0; apply=ENVIRON["WD_APPLY"]+0
  file=ENVIRON["WD_FILE"]; repair_file=ENVIRON["WD_REPAIR_FILE"]
  fields[1]="Decided"; fields[2]="Instead of"; fields[3]="Because"; fields[4]="Mine"; fields[5]="Revisit when"
  for (c=1;c<32;c++) controls[sprintf("%c",c)]=c
  if (ENVIRON["WD_COLOR"]+0) { bold="\033[1m"; dim="\033[2m"; off="\033[0m" }
  if (search_field!="") {
    search_field=key(search_field)
    if (search_field=="") fail("unknown --field; use Decided, Instead of, Because, Mine, Revisit when, Effort, Date, or Title")
  }
  if (after!="") { lower=iso(after); if (!date_ok) fail("invalid ISO-8601 --after date: " after) }
  if (before!="") { upper=iso(before); if (!date_ok) fail("invalid ISO-8601 --before date: " before); whole_day=date_only; if (whole_day) upper+=86400 }
  if (after!="" && before!="" && (whole_day ? lower>=upper : lower>upper)) fail("--after must not be later than --before")
  if (effort_filter!="" && effort_filter !~ /^[a-z0-9]+(-[a-z0-9]+)*$/) fail("invalid --effort slug: " effort_filter)
  if (ENVIRON["WD_FILE_EXISTS"]+0 != 1) {
    print "Error: No decisions file: " file > "/dev/stderr"; exit 1
  }
  scan_only=1
  while ((read_status=(getline source < file))>0) {
    line_no++; originals[line_no]=source; sub(/\r$/, "", source)
    process(source)
  }
  close(file)
  if (read_status<0) { print "Error: cannot read decisions file: " file > "/dev/stderr"; fatal=1; exit 1 }
  scan_only=0; comment=0; fence=""; total_lines=line_no
  for (line_no=1;line_no<=total_lines;line_no++) {
    source=originals[line_no]; sub(/\r$/, "", source); process(source)
  }
  line_no=total_lines
  validate()
  if (fix) {
    # No guessed dates, alternatives, ownership or rationale are ever inserted.
    if (repairs) {
      for (i=1;i<=line_no;i++) print (i in repair_line ? repair_line[i] : originals[i]) > repair_file
      close(repair_file)
    }
    if (format=="json") {
      printf "{\"dry_run\":%s,\"repairs\":%d,\"unresolved_entries\":%d,\"changes\":[",(apply ? "false" : "true"),repairs,errors
      sep=""
      for (i=1;i<=line_no;i++) if (i in repair_line) { printf "%s{\"line\":%d,\"before\":%s,\"after\":%s}",sep,i,json(originals[i]),json(repair_line[i]); sep="," }
      print "]}"
    } else {
      for (i=1;i<=line_no;i++) if (i in repair_line) printf "Line %d: %s\n     -> %s\n",i,originals[i],repair_line[i]
      printf "%s: %d formatting repair(s); %d entry/entries need content review.\n",(apply ? "Applying repairs" : "Dry-run (use --apply to write)"),repairs,errors
    }
    exit 0
  }
  if (command=="validate") {
    if (format=="json") printf "{\"valid\":%s,\"decisions\":%d,\"errors\":%d,\"warnings\":%d}\n",(errors ? "false" : "true"),count,errors,warnings
    else printf "Validated %d decision(s): %d malformed entry/entries, %d warning(s).\n",count,errors,warnings
    exit (errors ? 1 : 0)
  }
  if (format=="json") printf "["
  for (i=count;i>=1;i--) {
    if (effort_filter!="" && values[i,"Effort"]!=effort_filter) continue
    if ((after!="" || before!="") && !has_date[i]) continue
    if (after!="" && epoch[i]<lower) continue
    if (before!="" && (whole_day ? epoch[i]>=upper : epoch[i]>upper)) continue
    if (command=="search") {
      if (search_field=="Title") hay=entry_title[i]
      else if (search_field=="Date") hay=entry_date[i]
      else if (search_field!="") hay=values[i,search_field]
      else {
        hay=entry_title[i] "\n" entry_date[i]
        for (j=1;j<=5;j++) hay=hay "\n" values[i,fields[j]]
        hay=hay "\n" values[i,"Effort"]
      }
      if (!index(tolower(hay),term)) continue
    }
    if (limit && matches>=limit) break
    matches++
    if (format=="json") { if (matches>1) printf ","; object(i) }
    else text(i)
  }
  if (format=="json") print "]"
  else if (!matches) print (command=="search" ? "No matches found" : "No decisions recorded")
  else printf "Total: %d of %d decision(s)\n",matches,count
}
' || { status=$?; exit "$status"; }

if [ "$fix" -eq 1 ] && [ "$apply" -eq 1 ] && [ -s "$repair_file" ]; then
  # The fully written same-directory temporary file replaces the log atomically.
  if ! mv -f "$repair_file" "$repair_target"; then error "cannot apply repairs to $DECISIONS_FILE"; exit 1; fi
fi
