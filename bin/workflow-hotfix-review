#!/usr/bin/env bash
# workflow-hotfix-review - track temporary decisions needing durable solutions
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
DECISIONS_FILE="$ROOT/.workflow/decisions.md"
FORMAT=text
SHOW_ALL=0
NO_COLOR=0
MARK_ID=
MARK_REQUESTED=0
TMP=
trap 'if [ -n "$TMP" ]; then rm -f -- "$TMP"; fi' EXIT

usage() {
  cat <<'EOF'
workflow hotfix-review - track temporary decisions needing proper solutions

Hotfixes are short-term fixes, temporary decisions, workarounds, or emergency
patches recorded in Decided or Mine. Review them until a durable fix replaces
them. Multiple fixes in an entry are shown together and resolved together.

Usage:
  workflow hotfix-review [--all] [--format text|json] [--no-color]
  workflow hotfix-review --mark-resolved ID [--format text|json] [--no-color]

Options:
  --all                 Include resolved hotfix entries
  --mark-resolved ID     Add a resolved marker to this entry in decisions.md
  --format text|json    Select output format (default: text)
  --no-color            Disable TTY color output
  -h, --help            Show this help

IDs are lowercase, hyphen-separated heading slugs, including the date.
Legacy entries without headings use the Decided text. Duplicates get -2, -3.
Age uses the ISO 8601 timestamp in Decided, then Date or the entry heading.
Commit links use recorded URLs or the repository's origin remote if available.

Examples:
  workflow hotfix-review --all
  workflow hotfix-review --format json
  workflow hotfix-review --mark-resolved 2026-01-31-parser-workaround
EOF
}
error() { printf 'Error: workflow hotfix-review: %s\n' "$*" >&2; }
usage_error() { error "$*"; printf 'Try --help for usage.\n' >&2; exit 2; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help|help) usage; exit 0 ;;
    --all) SHOW_ALL=1 ;;
    --no-color) NO_COLOR=1 ;;
    --format)
      [ "$#" -ge 2 ] || usage_error '--format requires text or json'
      FORMAT=$2; shift ;;
    --format=*) FORMAT=${1#*=} ;;
    --mark-resolved)
      [ "$#" -ge 2 ] || usage_error '--mark-resolved requires an ID'
      MARK_REQUESTED=1; MARK_ID=$2; shift ;;
    --mark-resolved=*) MARK_REQUESTED=1; MARK_ID=${1#*=} ;;
    *) usage_error "unknown option: $1" ;;
  esac
  shift
done
case "$FORMAT" in text|json) ;; *) usage_error "unsupported format: $FORMAT" ;; esac
if [ "$MARK_REQUESTED" -eq 1 ]; then
  case "$MARK_ID" in ''|--*) usage_error '--mark-resolved requires an ID' ;; esac
  [ "$SHOW_ALL" -eq 0 ] || usage_error '--all cannot be combined with --mark-resolved'
fi

C_DIM= C_BOLD= C_RED= C_YELLOW= C_OFF=
if [ "$NO_COLOR" -eq 0 ] && [ -t 1 ]; then
  C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_RED=$'\033[31m'
  C_YELLOW=$'\033[33m'; C_OFF=$'\033[0m'
fi

# One record per entry. Non-whitespace separators retain empty fields in bash.
# Keep source line ranges so resolution changes only the selected entry.
parse_entries() {
  LC_ALL=C awk '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    function flat(s) { gsub(/[\034\035\r\n]/, " ", s); return trim(s) }
    function hotfix(s) {
      return tolower(s) ~ /(^|[^[:alnum:]_])(hot[ -]?fix(es)?|temporary|temporarily|work[ -]?arounds?|quick[ -]?fix(es)?|immediate[ -]?fix(es)?|stopgap|emergency[[:space:]]+(fix|patch))([^[:alnum:]_]|$)/
    }
    function iso(s) {
      if (match(s, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]([Tt ][0-9][0-9]:[0-9][0-9](:[0-9][0-9]([.][0-9]+)?)?([Zz]|[+-][0-9][0-9]:?[0-9][0-9])?)?/)) return substr(s, RSTART, RLENGTH)
      return ""
    }
    function reset() {
      delete fields; delete commit_seen; delete commit_order; delete commit_urls; delete fix_seen
      title=""; body=""; field=""; start=0; active=0; canonical=0
    }
    function emit(last,    slug,base,i,n,pieces,fixes,s,t,sha,pre,post,url,commits,d,resolved,ncommits) {
      if (!active || trim(fields["decided"]) == "") return
      n=split(fields["decided"] "\n" fields["mine"], pieces, /\n|;|[.][[:space:]]+/)
      fixes=""
      for (i=1; i<=n; i++) {
        t=trim(pieces[i]); sub(/^[-*][[:space:]]+/, "", t)
        if (hotfix(t) && !fix_seen[t]++) fixes=fixes (fixes!="" ? "\035" : "") flat(t)
      }
      # Generate IDs before filtering, so resolved/non-hotfix entries never shift IDs.
      slug=tolower(title!="" ? title : flat(fields["decided"]))
      gsub(/[^a-z0-9]+/, "-", slug); sub(/^-/, "", slug); sub(/-$/, "", slug)
      if (slug=="") slug="entry-" start
      base=slug; i=1
      while (slug_seen[slug]++) { i++; slug=base "-" i }
      if (fixes=="") return
      commits=""; s=body
      while (match(s, /[[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]]*/)) {
        sha=substr(s,RSTART,RLENGTH); pre=substr(s,1,RSTART-1); post=substr(s,RSTART+RLENGTH)
        if (length(sha)>=7 && length(sha)<=40 && pre !~ /[[:alnum:]_]$/ && post !~ /^[[:alnum:]_]/) {
          url=""
          if (match(pre, /https?:\/\/[^[:space:]<>()]+\/(commit|commits|revision)\/$/)) url=substr(pre,RSTART) sha
          # Contextual SHA references, backtick/markdown SHAs, and literal commit URLs.
          if (url!="" || tolower(pre) ~ /(commit|sha|revision|ref)[^[:alnum:]]*$/ || (pre ~ /(`|\[)$/ && post ~ /^(`|\])/)) {
            sha=tolower(sha)
            if (!commit_seen[sha]++) commit_order[++ncommits]=sha
            if (url!="") commit_urls[sha]=url
          }
        }
        s=post
      }
      for (i=1; i<=ncommits; i++) {
        sha=commit_order[i]; commits=commits (commits!="" ? "\035" : "") sha " " commit_urls[sha]
      }
      d=iso(fields["decided"]); if(d=="") d=iso(fields["date"]); if(d=="") d=iso(title)
      t=tolower(trim(fields["revisit when"]))
      resolved=(t ~ /(^|\n)(\[x\][[:space:]]*)?(resolved|completed|done|fixed)([^[:alnum:]_]|$)/)
      printf "%s\034%d\034%d\034%s\034%s\034%s\034%s\034%s\034%d\034%s\034%s\n", slug,start,last,flat(fields["decided"]),flat(fields["instead of"]),flat(fields["revisit when"]),d,flat(title),resolved,fixes,commits
    }
    BEGIN { reset() }
    {
      line=$0; sub(/\r$/, "", line)
      if (comment) {
        if (index(line,"-->")) comment=0
        next
      }
      if (line ~ /^[[:space:]]*<!--/) { if (!index(line,"-->")) comment=1; next }
      if (line ~ /^[[:space:]]*(```+|~~~+)/) {
        t=trim(line); marker=substr(t,1,1)
        if (!fence) { fence=marker; field="" } else if(fence==marker) fence=""
        next
      }
      if (fence) next
      if (line ~ /^##[[:space:]]+/) {
        emit(NR-1); reset()
        t=line; sub(/^##[[:space:]]+/, "", t)
        if (tolower(trim(t)) !~ /^(entries|format|why the runner-up is required)$/) {
          active=1; canonical=1; start=NR; title=t
        }
        next
      }
      if (line ~ /^#[[:space:]]+/) { emit(NR-1); reset(); next }
      if (line ~ /^[[:space:]]*[-*][[:space:]]+\*\*[^*]+:\*\*/) {
        key=line; sub(/^[[:space:]]*[-*][[:space:]]+\*\*/, "", key); sub(/:\*\*.*/, "", key); key=tolower(trim(key))
        value=line; sub(/^[[:space:]]*[-*][[:space:]]+\*\*[^*]+:\*\*[[:space:]]*/, "", value)
        if (key=="decided" && !canonical) { emit(NR-1); reset(); active=1; start=NR }
        if (active) {
          field=key; fields[key]=fields[key] (fields[key]!="" ? "\n" : "") value
          body=body "\n" line
        }
        next
      }
      if (active) {
        body=body "\n" line
        if (field!="" && line !~ /^###/ && trim(line)!="") fields[field]=fields[field] "\n" trim(line)
      }
    }
    END { emit(NR) }
  ' "$DECISIONS_FILE"
}

json_quote() {
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN { printf "\""; for(i=1;i<32;i++) control[sprintf("%c",i)]=i }
    { if (NR>1) printf "\\n"; for(i=1;i<=length($0);i++) {
        c=substr($0,i,1)
        if(c=="\\") printf "\\\\"; else if(c=="\"") printf "\\\""
        else if(c in control) printf "\\u%04x",control[c]; else printf "%s",c
    }}
    END { printf "\"" }
  '
}

# GNU date accepts ISO timestamps directly. BSD date needs explicit formats.
date_epoch() {
  local stamp=$1 normalized fmt
  if date -d "$stamp" +%s 2>/dev/null; then return; fi
  normalized=${stamp/T/ }; normalized=${normalized/t/ }
  normalized=${normalized/Z/+0000}; normalized=${normalized/z/+0000}
  if [[ "$normalized" =~ ([+-][0-9][0-9]):([0-9][0-9])$ ]]; then
    normalized=${normalized%${BASH_REMATCH[0]}}${BASH_REMATCH[1]}${BASH_REMATCH[2]}
  fi
  for fmt in '%Y-%m-%d %H:%M:%S%z' '%Y-%m-%d %H:%M%z' '%Y-%m-%d %H:%M:%S' '%Y-%m-%d %H:%M' '%Y-%m-%d'; do
    if date -j -f "$fmt" "$normalized" +%s 2>/dev/null; then return; fi
  done
  return 1
}

NOW=$(date +%s)
AGE_DAYS=null
AGE='unknown (no valid timestamp)'
set_age() {
  local stamp=$1 epoch days value unit suffix prefix=
  AGE_DAYS=null; AGE='unknown (no valid timestamp)'
  [ -n "$stamp" ] || return 0
  if ! epoch=$(date_epoch "$stamp"); then return 0; fi
  AGE_DAYS=$(( (NOW-epoch) / 86400 )); days=$AGE_DAYS
  if [ "$days" -lt 0 ]; then prefix='in '; days=$((-days)); fi
  if [ "$days" -lt 7 ]; then value=$days; unit=day
  elif [ "$days" -lt 30 ]; then value=$((days/7)); unit=week
  else value=$((days/30)); unit=month; fi
  suffix=s; [ "$value" -ne 1 ] || suffix=
  AGE="$prefix$value $unit$suffix"
}

if [ ! -f "$DECISIONS_FILE" ]; then
  if [ "$MARK_REQUESTED" -eq 1 ]; then error "decisions file not found: $DECISIONS_FILE"; exit 1; fi
  if [ "$FORMAT" = json ]; then printf '[]\n'; else printf 'No decisions file: %s\n' "$DECISIONS_FILE"; fi
  exit 0
fi
[ -r "$DECISIONS_FILE" ] || { error "cannot read decisions file: $DECISIONS_FILE"; exit 1; }
if ! RECORDS=$(parse_entries); then error "cannot parse decisions file: $DECISIONS_FILE"; exit 1; fi

if [ "$MARK_REQUESTED" -eq 1 ]; then
  FOUND=0
  while IFS=$'\034' read -r id first last decided instead revisit stamp heading resolved fixes commits; do
    [ "$id" = "$MARK_ID" ] || continue
    FOUND=1; break
  done <<< "$RECORDS"
  [ "$FOUND" -eq 1 ] || { error "hotfix entry not found: $MARK_ID"; exit 1; }
  if [ "$resolved" -eq 0 ]; then
    [ -w "$DECISIONS_FILE" ] || { error "cannot update decisions file: $DECISIONS_FILE"; exit 1; }
    TMP=$(mktemp "$DECISIONS_FILE.tmp.XXXXXX") || { error 'cannot create resolution update'; exit 1; }
    # Update one field, keeping the previous condition and all surrounding text.
    # A same-directory replacement preserves permissions and avoids partial writes.
    if ! cp -p "$DECISIONS_FILE" "$TMP"; then error 'cannot prepare resolution update'; exit 1; fi
    if ! awk -v first="$first" -v last="$last" '
      {
        line=$0; skip=0
        if (comment) { if(index(line,"-->")) comment=0; skip=1 }
        else if(line ~ /^[[:space:]]*<!--/) { if(!index(line,"-->")) comment=1; skip=1 }
        else if(line ~ /^[[:space:]]*(```+|~~~+)/) {
          marker=line; sub(/^[[:space:]]*/,"",marker); marker=substr(marker,1,1)
          if(!fence) fence=marker; else if(fence==marker) fence=""
          skip=1
        } else if(fence) skip=1
        if(NR>=first && NR<=last && !skip && !marked && line ~ /^[[:space:]]*[-*][[:space:]]+\*\*Revisit when:\*\*/) {
          prefix=line; sub(/\*\*Revisit when:\*\*.*/,"",prefix)
          previous=line; sub(/^[[:space:]]*[-*][[:space:]]+\*\*Revisit when:\*\*[[:space:]]*/,"",previous)
          line=prefix "**Revisit when:** resolved (marked by workflow hotfix-review)."
          if(previous!="") line=line " Previous condition: " previous
          marked=1
        }
        print line
        if(NR==last && !marked) print "- **Revisit when:** resolved (marked by workflow hotfix-review)."
      }
    ' "$DECISIONS_FILE" > "$TMP"; then error 'cannot write resolution update'; exit 1; fi
    if ! mv -f -- "$TMP" "$DECISIONS_FILE"; then error 'cannot update decisions file'; exit 1; fi
    TMP=
  fi
  if [ "$FORMAT" = json ]; then
    printf '{"id":'; json_quote "$MARK_ID"; printf ',"resolved":true}\n'
  else printf 'Marked hotfix resolved: %s\n' "$MARK_ID"; fi
  exit 0
fi

REMOTE=$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)
COMMIT_BASE=
case "$REMOTE" in
  https://*|http://*) COMMIT_BASE=${REMOTE%.git} ;;
  git@*:*) SCP_REMOTE=${REMOTE#git@}; COMMIT_BASE="https://${SCP_REMOTE/:/\/}"; COMMIT_BASE=${COMMIT_BASE%.git} ;;
  ssh://git@*) COMMIT_BASE="https://${REMOTE#ssh://git@}"; COMMIT_BASE=${COMMIT_BASE%.git} ;;
esac
COMMIT_BASE=${COMMIT_BASE%/}
COUNT=0; FIX_COUNT=0
if [ "$FORMAT" = json ]; then printf '['; fi
while IFS=$'\034' read -r id first last decided instead revisit stamp heading resolved fixes commits; do
  [ -n "$id" ] || continue
  if [ "$SHOW_ALL" -eq 0 ] && [ "$resolved" -eq 1 ]; then continue; fi
  set_age "$stamp"
  if [ "$FORMAT" = json ]; then
    if [ "$COUNT" -gt 0 ]; then printf ','; fi
    printf '{"id":'; json_quote "$id"; printf ',"decided":'; json_quote "$decided"
    printf ',"date":'; if [ -n "$stamp" ]; then json_quote "$stamp"; else printf null; fi
    printf ',"age_days":%s,"age":' "$AGE_DAYS"; json_quote "$AGE"
    printf ',"resolved":'; if [ "$resolved" -eq 1 ]; then printf true; else printf false; fi
    printf ',"instead_of":'; json_quote "$instead"; printf ',"revisit_when":'; json_quote "$revisit"
    printf ',"hotfixes":['
  else
    if [ "$COUNT" -eq 0 ]; then printf '%sHotfix Review:%s\n\n' "$C_BOLD" "$C_OFF"; fi
    if [ "$resolved" -eq 1 ]; then printf '%s%s [RESOLVED] %s%s\n' "$C_DIM" "$id" "$decided" "$C_OFF"
    else printf '%s%s %s%s\n' "$C_RED" "$id" "$decided" "$C_OFF"; fi
    printf '   Age: %s\n' "$AGE"
  fi
  index=0
  while IFS= read -r fix; do
    [ -n "$fix" ] || continue
    if [ "$FORMAT" = json ]; then if [ "$index" -gt 0 ]; then printf ','; fi; json_quote "$fix"
    else printf '   Hotfix %d: %s\n' "$((index+1))" "$fix"; fi
    index=$((index+1)); FIX_COUNT=$((FIX_COUNT+1))
  done <<< "${fixes//$'\035'/$'\n'}"
  if [ "$FORMAT" = json ]; then printf '],"commits":['; fi
  index=0
  while IFS= read -r reference; do
    [ -n "$reference" ] || continue
    sha=${reference%% *}; url=${reference#* }
    if [ -z "$url" ] && [ -n "$COMMIT_BASE" ]; then url="$COMMIT_BASE/commit/$sha"; fi
    if [ "$FORMAT" = json ]; then
      if [ "$index" -gt 0 ]; then printf ','; fi
      printf '{"sha":'; json_quote "$sha"; printf ',"url":'
      if [ -n "$url" ]; then json_quote "$url"; else printf null; fi; printf '}'
    else printf '   Original commit: %s' "$sha"; if [ -n "$url" ]; then printf ' (%s)' "$url"; fi; printf '\n'; fi
    index=$((index+1))
  done <<< "${commits//$'\035'/$'\n'}"
  if [ "$FORMAT" = json ]; then printf ']}'
  else
    if [ -n "$instead" ]; then printf '   %sProper solution:%s %s\n' "$C_YELLOW" "$C_OFF" "$instead"; fi
    if [ -n "$revisit" ]; then printf '   %sRevisit:%s %s\n' "$C_DIM" "$C_OFF" "$revisit"; fi
    printf '\n'
  fi
  COUNT=$((COUNT+1))
done <<< "$RECORDS"
if [ "$FORMAT" = json ]; then printf ']\n'
elif [ "$COUNT" -eq 0 ]; then
  if [ "$SHOW_ALL" -eq 1 ]; then printf 'No hotfixes found in decisions log\n'; else printf 'No unresolved hotfixes\n'; fi
elif [ "$SHOW_ALL" -eq 1 ]; then printf '%sTotal: %d hotfixes in %d entries%s\n' "$C_DIM" "$FIX_COUNT" "$COUNT" "$C_OFF"
else printf '%s%d unresolved hotfixes in %d entries need proper solutions%s\n' "$C_YELLOW" "$FIX_COUNT" "$COUNT" "$C_OFF"; fi
