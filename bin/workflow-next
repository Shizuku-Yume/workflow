#!/usr/bin/env bash
# workflow-next - suggest ready tasks in effort-priority order
set -euo pipefail
KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/workflow-lib.bash"
source "$KIT_LIB"

ROOT="$(wf_project_root)"
TASKS_DIR="$ROOT/.workflow/tasks"
DONE_DIR="$ROOT/.workflow/done"
EFFORTS_DIR="$ROOT/.workflow/efforts"
INTERACTIVE=0
COLOR_DISABLED=0
FORMAT="text"

usage() {
  cat <<'EOF'
workflow next - suggest what to work on next

Usage: workflow next [--interactive] [--format text|json] [--no-color]

Shows the top five tasks explicitly marked "Blocked by: None" (also accepts
"None, can start now"), with their effort goal and Check preview. Priorities
sort critical/urgent, high, normal (default), then low; ties sort by task number.
Blockers already archived under `.workflow/done/` count as satisfied. When none
are ready, shows the dependencies blocking the most tasks.

Options:
  --interactive  Select a task and print instructions to start flow-implement
                 with your AI assistant (skills are not shell executables)
  --format TYPE  Output text (default) or JSON; JSON cannot be interactive
  --no-color     Disable terminal colors
  -h, --help     Show this help

Examples:
  workflow next
  workflow next --interactive
  workflow next --no-color
  workflow next --format json
EOF
}
error() { printf 'Error: %s\n' "$*" >&2; }
warn() { printf 'Warning: %s\n' "$*" >&2; }
trim() { wf_trim "$1"; REPLY="$WF_TRIMMED"; }
number() { wf_normalize_number "$1"; REPLY="$WF_NUMBER"; }
json_string() { wf_json_string "$1"; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --interactive) INTERACTIVE=1 ;;
    --no-color) COLOR_DISABLED=1 ;;
    --format)
      [ "$#" -ge 2 ] || { error '--format requires text or json'; exit 2; }
      FORMAT="$2"
      case "$FORMAT" in text|json) ;; *) error '--format must be text or json'; exit 2 ;; esac
      shift
      ;;
    *) error "unknown option: $1 (try 'workflow next --help')"; exit 2 ;;
  esac
  shift
done
if [ "$INTERACTIVE" -eq 1 ] && [ "$FORMAT" = "json" ]; then
  error '--interactive cannot be combined with --format json'
  exit 2
fi

C_BOLD=""; C_DIM=""; C_OFF=""
if [ -t 1 ] && [ "$COLOR_DISABLED" -eq 0 ] && [ -z "${NO_COLOR:-}" ]; then
  C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
fi

# Read task and effort metadata with the shared reader. META mirrors the
# lowercase field names, plus `title` from the `# NN:` heading or Task field.
read_metadata() {
  local k
  wf_read_fields "$1"
  META=()
  for k in "${!WF_FIELD[@]}"; do META["$k"]="${WF_FIELD[$k]}"; done
  if [ -n "$WF_TITLE" ]; then META[title]="$WF_TITLE"
  elif [ -n "${WF_FIELD[task]:-}" ]; then META[title]="${WF_FIELD[task]}"; fi
}

[ -d "$ROOT/.workflow" ] || { error "no .workflow directory at $ROOT; run 'workflow init' first"; exit 1; }
if [ ! -d "$TASKS_DIR" ]; then
  if [ "$FORMAT" = "json" ]; then
    printf '{"ready_tasks":[],"ready_count":0,"task_count":0,"blocked_count":0,"blockers":[]}\n'
  else
    printf 'No tasks found (tasks directory is missing).\n'
  fi
  exit 0
fi

# Sort only numeric keys and record indexes; task text never enters the sorter.
declare -A META=() GOALS=() PRIORITIES=() RANKS=() BLOCK_COUNTS=() BLOCK_TASKS=() BLOCK_NUMBERS=()
declare -A ARCHIVED=()
declare -a REFERENCES=() TITLES=() EFFORTS=() CHECKS=() SORT_KEYS=()
READY_COUNT=0
TASK_COUNT=0
BLOCKED_COUNT=0
shopt -s nullglob

# Blockers archived under .workflow/done/<effort>/ are finished, so they never
# block: collect their <effort>/<NN> keys before evaluating active tasks.
if [ -d "$DONE_DIR" ]; then
  wf_task_files "$DONE_DIR"
  for file in "${WF_FILES[@]}"; do
    [ -f "$file" ] || continue
    basename="${file##*/}"
    [[ "$basename" =~ ^([0-9]+)-.+\.md$ ]] || continue
    wf_dir_effort "$DONE_DIR" "$file"; effort="$WF_DIR_EFFORT"
    [ -n "$effort" ] || continue
    archived_key_number="${BASH_REMATCH[1]}"
    read_metadata "$file"
    [ -n "${META[effort]:-}" ] && effort="${META[effort]}"
    wf_ref "$effort" "$archived_key_number"
    ARCHIVED["$WF_REF"]=1
  done
fi
# BLOCK_TASKS holds <effort>/<NN> names for text; BLOCK_NUMBERS keeps bare
# numbers for the JSON contract.
record_blocker() {
  local blocker="$1" task="$2" task_number="$3"
  BLOCK_COUNTS["$blocker"]=$(( ${BLOCK_COUNTS[$blocker]:-0} + 1 ))
  BLOCK_TASKS["$blocker"]="${BLOCK_TASKS[$blocker]:+${BLOCK_TASKS[$blocker]}, }$task"
  BLOCK_NUMBERS["$blocker"]="${BLOCK_NUMBERS[$blocker]:+${BLOCK_NUMBERS[$blocker]},}$task_number"
}

wf_task_files "$TASKS_DIR"
for file in "${WF_FILES[@]}"; do
  [ -f "$file" ] || continue
  [ -r "$file" ] || { error "cannot read task: $file"; exit 1; }
  basename="${file##*/}"
  if [[ ! "$basename" =~ ^([0-9]+)-.+\.md$ ]]; then
    warn "ignoring task with invalid filename: $basename"
    continue
  fi
  filename_number="${BASH_REMATCH[1]}"
  number "$filename_number"; num="$REPLY"
  read_metadata "$file"
  case "${META[status]:-active}" in done|completed|archived) continue ;; esac
  effort="${META[effort]:-none}"
  if [[ ! "$effort" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    warn "$basename has an invalid effort reference; using default priority"
    effort="none"
  fi
  TASK_COUNT=$((TASK_COUNT + 1))
  wf_ref "$effort" "$num"; ref="$WF_REF"
  # A task with no active blockers is ready, whatever its Blocked by line says:
  # numbers already archived under done/ count as finished.
  blocked="${META[blocked by]:-}"
  task_blocked=0
  if [ -z "$blocked" ]; then
    task_blocked=1
    record_blocker '(missing Blocked by field)' "$ref" "$num"
  else
    rc=0
    wf_parse_blockers "$blocked" 0 || rc=$?
    if [ "$rc" -ne 0 ]; then
      task_blocked=1
      warn "$basename has malformed Blocked by: $blocked"
      record_blocker '(malformed Blocked by field)' "$ref" "$num"
    elif [ "$WF_REFS_COUNT" -gt 0 ]; then
      declare -A seen=()
      for ((i = 0; i < WF_REFS_COUNT; i++)); do
        token="${WF_REFS[$i]}"
        if [[ "$token" == */* ]]; then wf_ref "${token%%/*}" "${token##*/}"; else wf_ref "$effort" "$token"; fi
        token="$WF_REF"
        # Finished blockers under done/<effort>/ no longer gate this task.
        [ -n "${ARCHIVED[$token]:-}" ] || seen["$token"]=1
      done
      if [ "${#seen[@]}" -gt 0 ]; then
        task_blocked=1
        for token in "${!seen[@]}"; do record_blocker "$token" "$ref" "$num"; done
      fi
    fi
  fi
  if [ "$task_blocked" -eq 1 ]; then
    BLOCKED_COUNT=$((BLOCKED_COUNT + 1))
    continue
  fi
  title="${META[title]:-Untitled}"
  check="${META[check]:-(not specified)}"
  if [ -z "${PRIORITIES[$effort]+set}" ]; then
    priority="normal"; goal="(not specified)"
    if [ -f "$EFFORTS_DIR/$effort.md" ]; then
      [ -r "$EFFORTS_DIR/$effort.md" ] || { error "cannot read effort: $effort"; exit 1; }
      read_metadata "$EFFORTS_DIR/$effort.md"
      priority="${META[priority]:-normal}"
      priority="${priority,,}"
      goal="${META[goal]:-(not specified)}"
    elif [ "$effort" != "none" ]; then
      warn "effort definition missing: $effort (using normal priority)"
    fi
    case "$priority" in
      critical|urgent) rank=0 ;;
      high) rank=1 ;;
      normal) rank=2 ;;
      low) rank=3 ;;
      *) warn "unknown priority '$priority' for effort $effort; using normal"; priority="normal"; rank=2 ;;
    esac
    PRIORITIES["$effort"]="$priority"; RANKS["$effort"]="$rank"; GOALS["$effort"]="$goal"
  fi
  REFERENCES+=("$ref"); TITLES+=("$title"); EFFORTS+=("$effort"); CHECKS+=("$check")
  SORT_KEYS+=("${RANKS[$effort]}"$'\t'"$num"$'\t'"$READY_COUNT")
  READY_COUNT=$((READY_COUNT + 1))
done

if [ "$FORMAT" = "json" ]; then
  printf '{"ready_count":%s,"task_count":%s,"blocked_count":%s,"ready_tasks":[' "$READY_COUNT" "$TASK_COUNT" "$BLOCKED_COUNT"
  shown=0
  if [ "$READY_COUNT" -gt 0 ]; then
    while IFS=$'\t' read -r rank num index; do
      [ "$shown" -eq 0 ] || printf ','
      effort="${EFFORTS[$index]}"
      printf '{"number":%s,"title":' "$num"; json_string "${TITLES[$index]}"
      printf ',"effort":'; json_string "$effort"
      printf ',"priority":'; json_string "${PRIORITIES[$effort]}"
      printf ',"goal":'; json_string "${GOALS[$effort]}"
      printf ',"check":'; json_string "${CHECKS[$index]}"
      printf ',"start_command":'; json_string "flow-implement ${REFERENCES[$index]}"
      printf '}'
      shown=$((shown + 1)); [ "$shown" -lt 5 ] || break
    done < <(printf '%s\n' "${SORT_KEYS[@]}" | LC_ALL=C sort -t $'\t' -k1,1n -k2,2n -k3,3n)
  fi
  printf '],"blockers":['
  rows=()
  for blocker in "${!BLOCK_COUNTS[@]}"; do rows+=("${BLOCK_COUNTS[$blocker]}"$'\t'"$blocker"); done
  shown=0
  if [ "${#rows[@]}" -gt 0 ]; then
    while IFS=$'\t' read -r count blocker; do
      [ "$shown" -eq 0 ] || printf ','
      printf '{"dependency":'; json_string "$blocker"
      printf ',"count":%s,"tasks":[' "$count"
      IFS=',' read -r -a waiting <<< "${BLOCK_NUMBERS[$blocker]}"
      separator=""
      for num in "${waiting[@]}"; do printf '%s%s' "$separator" "$num"; separator=','; done
      printf ']}'
      shown=$((shown + 1)); [ "$shown" -lt 5 ] || break
    done < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t $'\t' -k1,1nr -k2,2)
  fi
  printf ']}\n'
  exit 0
fi

if [ "$READY_COUNT" -eq 0 ]; then
  if [ "$TASK_COUNT" -eq 0 ]; then
    printf 'No tasks found.\n'
  else
    printf 'No ready tasks. %s task(s) blocked.\n' "$BLOCKED_COUNT"
    printf 'Blockers affecting the most tasks:\n'
    rows=()
    for blocker in "${!BLOCK_COUNTS[@]}"; do rows+=("${BLOCK_COUNTS[$blocker]}"$'\t'"$blocker"); done
    shown=0
    while IFS=$'\t' read -r count blocker; do
      printf '  %s: %s task(s) (tasks: %s)\n' "$blocker" "$count" "${BLOCK_TASKS[$blocker]}"
      shown=$((shown + 1)); [ "$shown" -lt 5 ] || break
    done < <(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t $'\t' -k1,1nr -k2,2)
    printf 'Complete blockers and update Blocked by to None when dependencies are satisfied.\n'
  fi
  exit 0
fi

printf '%sReady tasks%s (%s total; showing up to 5):\n' "$C_BOLD" "$C_OFF" "$READY_COUNT"
SELECTIONS=()
while IFS=$'\t' read -r rank num index; do
  effort="${EFFORTS[$index]}"
  SELECTIONS+=("$index")
  printf '%s) %s%s%s %s (priority: %s)\n' "${#SELECTIONS[@]}" "$C_BOLD" "${REFERENCES[$index]}" "$C_OFF" "${TITLES[$index]}" "${PRIORITIES[$effort]}"
  printf '   %sGoal:%s %s\n' "$C_DIM" "$C_OFF" "${GOALS[$effort]}"
  printf '   %sCheck:%s %s\n' "$C_DIM" "$C_OFF" "${CHECKS[$index]}"
  printf '   Start: flow-implement %s\n' "${REFERENCES[$index]}"
  [ "${#SELECTIONS[@]}" -lt 5 ] || break
done < <(printf '%s\n' "${SORT_KEYS[@]}" | LC_ALL=C sort -t $'\t' -k1,1n -k2,2n -k3,3n)

if [ "$INTERACTIVE" -eq 1 ]; then
  printf 'Select a task [1-%s] (q to cancel): ' "${#SELECTIONS[@]}" >&2
  if ! IFS= read -r choice; then error 'no selection received'; exit 1; fi
  trim "$choice"; choice="$REPLY"
  case "$choice" in q|Q|'') printf 'Cancelled.\n'; exit 0 ;; esac
  case "$choice" in 1|2|3|4|5) ;; *) error 'select one of the displayed task numbers (1-5), or q to cancel'; exit 2 ;; esac
  if [ "$choice" -gt "${#SELECTIONS[@]}" ]; then error 'selection is outside the displayed task list'; exit 2; fi
  index="${SELECTIONS[$((choice - 1))]}"
  if [ ! -f "$ROOT/.agents/skills/flow-implement/SKILL.md" ]; then
    error "flow-implement skill not installed. Run 'workflow init' first."
    exit 1
  fi
  printf '\nNext task: %s - %s\n' "${REFERENCES[$index]}" "${TITLES[$index]}"
  printf 'To start: Ask your AI assistant to "run flow-implement on task %s"\n' "${REFERENCES[$index]}"
fi
