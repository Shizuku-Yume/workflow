#!/usr/bin/env bash
# workflow - install a project workflow: skills, agent rules, and document layout.
#
# Installs into the current repository, not globally. Everything it writes is
# tracked by git in that repository, so a teammate who clones the repo gets the
# same workflow with no extra step.
#
#   workflow init        install into the current project
#   workflow update      re-copy the skills after this toolkit changes
#   workflow doctor      check what is installed and what is missing
#   workflow uninstall   remove everything it installed
#   workflow hook        install a pre-commit hook that runs workflow validate
#   workflow validate    check task files and the decision log (bin/workflow-core.py)
#   workflow next        list ready tasks (bin/workflow-core.py)
#   workflow task        manage task lifecycle state transitions (bin/workflow-core.py)
#
# Runs on Bash 3.2 (stock macOS) with BSD or GNU awk and sed; validate, next
# and task need python3.
#
# Skills are copied, not linked, so a project keeps working if this toolkit is
# moved or deleted. Use `workflow update` to pull in newer versions.
#
# The CLI itself is copied too, into .workflow/bin/, so the commands the skills
# call exist for every clone of the project: teammates, CI and cloud agents
# need no checkout of this toolkit and nothing on PATH.
set -euo pipefail

VERSION="2.10.0"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT="$(cd "$BIN_DIR/.." && pwd)"

# The project's committed copy (.workflow/bin/workflow) has no skills or
# templates beside it. It runs the daily commands, doctor and hook; init, update
# and uninstall need a toolkit checkout because they copy from it.
VENDORED=0
if [ ! -d "$KIT/skills" ] && [ "${KIT##*/}" = ".workflow" ]; then VENDORED=1; fi
TOOLKIT_URL="https://github.com/Shizuku-Yume/workflow"
HOOK_MARKER="# workflow:pre-commit"
HOOK_BLOCK_START="# workflow:pre-commit:start"
HOOK_BLOCK_END="# workflow:pre-commit:end"
MARKER_START="<!-- workflow:start -->"
MARKER_END="<!-- workflow:end -->"

# Regexes live in variables: Bash 3.2 can't parse ( | ) in a literal =~ pattern.
RE_DIGITS='^[0-9]+$'
RE_STANDARDS_PLACEHOLDER='<TODO:[^>]+>|<(install|run|test|typecheck|lint) command>|<direct \| local-merge \| pr>'
GA_START="# workflow:start"
GA_END="# workflow:end"

# Framework files earlier versions installed; update removes unedited copies.
RETIRED_FRAMEWORK="thinking.md phase-boundaries.md merge-strategy.md spike-tasks.md"
# ---------------------------------------------------------------- output

if [ -t 2 ]; then
  C_DIM=$'\033[2m'; C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_OFF=$'\033[0m'
else
  C_DIM=""; C_OK=""; C_WARN=""; C_ERR=""; C_OFF=""
fi

say()  { printf '%s\n' "$*" >&2; }
ok()   { printf '%s✓%s %s\n' "$C_OK" "$C_OFF" "$*" >&2; }
skip() { printf '%s·%s %s\n' "$C_DIM" "$C_OFF" "$*" >&2; }
warn() { printf '%s!%s %s\n' "$C_WARN" "$C_OFF" "$*" >&2; }
die()  { rm -f "${MANIFEST_STAGE:-}"; printf '%s✗%s %s\n' "$C_ERR" "$C_OFF" "$*" >&2; exit 1; }

WORKFLOW_TMP_FILES=()
cleanup_tmp_files() {
  local f
  for f in "${WORKFLOW_TMP_FILES[@]}"; do
    rm -rf "$f" 2>/dev/null || true
  done
  [ -n "${MANIFEST_STAGE:-}" ] && rm -f "$MANIFEST_STAGE" 2>/dev/null || true
}
trap cleanup_tmp_files EXIT HUP INT TERM

wf_mktemp() {
  local tmp
  tmp="$(mktemp "$@")"
  WORKFLOW_TMP_FILES[${#WORKFLOW_TMP_FILES[@]}]="$tmp"
  printf '%s\n' "$tmp"
}
# ---------------------------------------------------------------- helpers

# bump VAR [N] - add N (default 1) to the caller's counter named VAR.
bump() { eval "$1=\$((\$$1 + ${2:-1}))"; }

# Print an absolute path with every symlink resolved and . and .. removed;
# components that do not exist are kept as written (like GNU `realpath -m`,
# which BSD lacks). Fails on a symlink loop.
normalize_path() {
  local rest="$1" out="" part target hops=0
  case "$rest" in /*) ;; *) rest="$PWD/$rest" ;; esac
  while :; do
    while [ "${rest#/}" != "$rest" ]; do rest="${rest#/}"; done
    [ -n "$rest" ] || break
    part="${rest%%/*}"
    if [ "$part" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
    case "$part" in
      .) continue ;;
      ..) out="${out%/*}"; continue ;;
    esac
    if [ -L "$out/$part" ]; then
      hops=$((hops + 1)); [ "$hops" -le 40 ] || return 1
      target="$(readlink "$out/$part")" || return 1
      case "$target" in /*) out="" ;; esac
      rest="$target/$rest"
      continue
    fi
    out="$out/$part"
  done
  printf '%s\n' "${out:-/}"
}

# Is python3 (3.8+) on PATH? validate and next run on it.
have_python() {
  command -v python3 >/dev/null 2>&1 &&
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1
}

# The repository's main branch: main if it exists, else master, else empty.
main_branch() {
  local root="$1" name
  for name in main master; do
    if git -C "$root" rev-parse --verify --quiet "refs/heads/$name" >/dev/null 2>&1; then
      printf '%s\n' "$name"
      return 0
    fi
  done
  return 0
}

# The checked-out branch name, empty on a detached HEAD.
current_branch() {
  git -C "$1" symbolic-ref --short -q HEAD 2>/dev/null || true
}

# The version: line of a .workflow-version manifest, empty when absent.
manifest_version() {
  sed -n 's/^version: //p' "$1" 2>/dev/null | head -n 1
}

# Find the project root with Git, falling back to the requested directory.
project_root() {
  local dir="${1:-$PWD}" root
  if root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
    printf '%s\n' "$root"
  else
    printf '%s\n' "$dir"
  fi
}

skill_names() {
  for d in "$KIT"/skills/*/; do
    [ -f "$d/SKILL.md" ] || continue
    basename "${d%/}"
  done
}

# Skills the project should have: the toolkit's list, or, from the committed
# copy, the list the last install recorded in the manifest.
expected_skills() {
  if [ -d "$KIT/skills" ]; then skill_names
  elif [ -f "$1/.workflow/.workflow-version" ]; then sed -n 's/^  - //p' "$1/.workflow/.workflow-version"
  fi
}

# Review agents the project should have, by name.
expected_agents() {
  local f from_manifest=""
  if [ -d "$KIT/templates/project/.agents/agents" ]; then
    for f in "$KIT"/templates/project/.agents/agents/*.md; do [ -f "$f" ] && basename "$f" .md; done
    return 0
  fi
  if [ -f "$1/.workflow/.workflow-version" ]; then
    from_manifest="$(awk '
      /^managed:$/ { in_m = 1; next }
      in_m && /^[^ ]/ { in_m = 0 }
      in_m && $2 ~ /^\.agents\/agents\/[^/]+\.md$/ {
        k = $2
        sub(/^\.agents\/agents\//, "", k)
        sub(/\.md$/, "", k)
        print k
      }
    ' "$1/.workflow/.workflow-version")"
  fi
  if [ -n "$from_manifest" ]; then
    printf '%s\n' "$from_manifest"
    return 0
  fi
  for f in "$1"/.agents/agents/*.md; do
    [ -f "$f" ] || continue
    [ -f "$1/.agents/agents/.$(basename "$f" .md).workflow-managed" ] && basename "$f" .md
  done
  return 0
}

# Path of a toolkit file to compare against, or empty from the committed copy
# (where "$KIT" is .workflow/ and the path would be the project's own file).
kit_file() {
  if [ "$VENDORED" = 0 ] && [ -f "$1" ]; then printf '%s\n' "$1"; fi
}

# The CLI files copied into .workflow/bin/.
cli_files() {
  local f
  for f in "$KIT/bin/workflow" "$KIT"/bin/workflow-*; do
    [ -f "$f" ] && printf '%s\n' "${f##*/}"
  done
  return 0
}

require_kit() {
  if [ "$VENDORED" = 1 ]; then
    die "this is the project's committed copy in .workflow/bin; run 'workflow ${1:-init}' from a toolkit checkout ($TOOLKIT_URL)"
  fi
  [ -d "$KIT/skills" ] || die "no skills/ directory next to $(basename "${BASH_SOURCE[0]}")"
  [ -f "$KIT/CONVENTIONS.md" ] || die "no CONVENTIONS.md next to $(basename "${BASH_SOURCE[0]}")"
  [ -f "$KIT/STYLE.md" ] || die "no STYLE.md next to $(basename "${BASH_SOURCE[0]}")"
}

# Symlink safety helpers: ensure managed files and trees remain strictly within the project root.
check_path_symlink_safety() {
  local root="$1" path="$2"
  local c_root resolved
  c_root="$(cd "$root" 2>/dev/null && pwd -P || normalize_path "$root")"
  c_root="${c_root%/}"
  [ -z "$c_root" ] && c_root="/"

  local abs_path="$path"
  if [[ "$abs_path" != /* ]]; then
    abs_path="$root/$abs_path"
  fi

  resolved="$(normalize_path "$abs_path" 2>/dev/null || true)"
  resolved="${resolved%/}"
  if [ "$resolved" != "$c_root" ] && [[ "$resolved" != "$c_root"/* ]]; then
    return 1
  fi

  local rel=""
  if [[ "$abs_path" == "$root"/* ]]; then
    rel="${abs_path#"$root"}"
    rel="${rel#/}"
  fi

  if [ -n "$rel" ]; then
    local cur="$root"
    local part
    local -a parts
    IFS='/' read -r -a parts <<< "$rel"
    for part in "${parts[@]}"; do
      [ -n "$part" ] || continue
      cur="$cur/$part"
      if [ -L "$cur" ]; then
        local link_res
        link_res="$(normalize_path "$cur" 2>/dev/null || true)"
        link_res="${link_res%/}"
        if [ "$link_res" != "$c_root" ] && [[ "$link_res" != "$c_root"/* ]]; then
          return 1
        fi
      fi
    done
  fi
  return 0
}

check_symlink_safety() {
  local root="$1"
  local target="${2:-}"
  if [ -n "$target" ]; then
    check_path_symlink_safety "$root" "$target"
    return $?
  fi

  local top link sublink
  for top in "$root/.workflow" "$root/.agents" "$root/AGENTS.md" "$root/.claude" "$root/CLAUDE.md" "$root/.gitattributes"; do
    if [ -e "$top" ] || [ -L "$top" ]; then
      if ! check_path_symlink_safety "$root" "$top"; then
        return 1
      fi
      if [ -d "$top" ]; then
        while IFS= read -r -d '' link; do
          if ! check_path_symlink_safety "$root" "$link"; then
            return 1
          fi
          if [ -d "$link" ]; then
            while IFS= read -r -d '' sublink; do
              if ! check_path_symlink_safety "$root" "$sublink"; then
                return 1
              fi
            done < <(find "$link/" -type l -print0 2>/dev/null)
          fi
        done < <(find "$top/" -type l -print0 2>/dev/null)
      fi
    fi
  done

  # Enumerate all concrete managed targets that workflow reads, writes, or deletes.
  local name src f d a_name
  local skills_root
  for name in $(skill_names); do
    for skills_root in "$root/.agents/skills" "$root/.claude/skills"; do
      check_path_symlink_safety "$root" "$skills_root/$name" || return 1
      check_path_symlink_safety "$root" "$skills_root/$name/SKILL.md" || return 1
      check_path_symlink_safety "$root" "$skills_root/$name/.workflow-managed" || return 1
    done
  done

  if [ -d "$KIT/templates/project/.agents/agents" ]; then
    for src in "$KIT"/templates/project/.agents/agents/*.md; do
      [ -f "$src" ] || continue
      a_name="$(basename "$src")"
      check_path_symlink_safety "$root" "$root/.agents/agents/$a_name" || return 1
      check_path_symlink_safety "$root" "$root/.agents/agents/.${a_name%.md}.workflow-managed" || return 1
      check_path_symlink_safety "$root" "$root/.claude/agents/$a_name" || return 1
      check_path_symlink_safety "$root" "$root/.claude/agents/.${a_name%.md}.workflow-managed" || return 1
    done
  fi

  for f in CONVENTIONS.md STYLE.md; do
    check_path_symlink_safety "$root" "$root/.workflow/$f" || return 1
    check_path_symlink_safety "$root" "$root/.workflow/.${f%.md}.workflow-managed" || return 1
  done

  for f in standards.md glossary.md decisions.md technical-debt.md $RETIRED_FRAMEWORK; do
    check_path_symlink_safety "$root" "$root/.workflow/$f" || return 1
  done
  for f in $RETIRED_FRAMEWORK; do
    check_path_symlink_safety "$root" "$root/.workflow/.${f%.md}.workflow-managed" || return 1
  done
  check_path_symlink_safety "$root" "$root/.gitattributes" || return 1

  for d in specs tasks maps done; do
    check_path_symlink_safety "$root" "$root/.workflow/$d" || return 1
  done

  check_path_symlink_safety "$root" "$root/.workflow/.workflow-version" || return 1
  check_path_symlink_safety "$root" "$root/AGENTS.md" || return 1
  check_path_symlink_safety "$root" "$root/.workflow/.agents-block.workflow-managed" || return 1
  check_path_symlink_safety "$root" "$root/CLAUDE.md" || return 1
  check_path_symlink_safety "$root" "$root/.workflow/.claude-block.workflow-managed" || return 1
  check_path_symlink_safety "$root" "$root/.workflow/bin" || return 1
  check_path_symlink_safety "$root" "$root/.workflow/bin/.workflow-managed" || return 1
  for f in $(cli_files); do
    check_path_symlink_safety "$root" "$root/.workflow/bin/$f" || return 1
  done

  return 0
}

assert_symlink_safety() {
  local root="$1"
  local target="${2:-}"
  if ! check_symlink_safety "$root" "$target"; then
    if [ -n "$target" ]; then
      die "symlink safety violation: '$target' escapes project root '$root'"
    else
      die "symlink safety violation: managed path escapes project root '$root'"
    fi
  fi
}

# Parse AGENTS.md workflow block markers.
# Returns: "<starts> <ends> <malformed>"
parse_agents_marker_state() {
  local file="$1"
  if [ ! -f "$file" ]; then
    printf '0 0 0\n'
    return 0
  fi
  awk -v s="$MARKER_START" -v e="$MARKER_END" '
    index($0, s) {
      if ($0 == s) {
        starts++
        if (inside) malformed = 1
        inside = 1
      } else {
        malformed = 1
      }
      next
    }
    index($0, e) {
      if ($0 == e) {
        ends++
        if (!inside) malformed = 1
        inside = 0
      } else {
        malformed = 1
      }
      next
    }
    END {
      if (inside) malformed = 1
      print starts + 0, ends + 0, malformed + 0
    }
  ' "$file"
}

# Ownership checksums live under `managed:` in .workflow/.workflow-version
# ("  <cksum> <key>"). Earlier installs wrote per-file .workflow-managed
# dotfiles (empty in 2.0, checksum in 2.1–2.9.0); lookup_managed reads the
# manifest first and falls back to legacy dotfiles until `update` migrates them.
MANIFEST_STAGE=""

file_cksum() {
  cksum < "$1" | cut -d' ' -f1
}

manifest_lookup_raw() {
  local vf="$1/.workflow/.workflow-version" key="$2"
  [ -f "$vf" ] || return 0
  awk -v k="$key" '
    /^managed:$/ { in_m = 1; next }
    in_m && /^[^ ]/ { in_m = 0 }
    in_m && $2 == k { print $1; exit }
  ' "$vf"
}

# Print sum:<digits> | empty | corrupt | none for KEY in ROOT, falling back to LEGACY_MARKER.
lookup_managed() {
  local root="$1" key="$2" legacy="${3:-}" recorded=""
  recorded="$(manifest_lookup_raw "$root" "$key")"
  if [ -n "$recorded" ]; then
    if [[ "$recorded" =~ $RE_DIGITS ]]; then printf 'sum:%s\n' "$recorded"; else printf 'corrupt\n'; fi
    return 0
  fi
  if [[ "$key" == .workflow/bin/* ]] && [ -f "$root/.workflow/bin/.workflow-managed" ]; then
    local bname="${key#.workflow/bin/}"
    recorded="$(awk -v n="$bname" '$2 == n { print $1; exit }' "$root/.workflow/bin/.workflow-managed")"
    if [ -n "$recorded" ]; then
      if [[ "$recorded" =~ $RE_DIGITS ]]; then printf 'sum:%s\n' "$recorded"; else printf 'corrupt\n'; fi
      return 0
    fi
  fi
  if [ -n "$legacy" ] && [ -f "$legacy" ]; then
    recorded="$(cat "$legacy" 2>/dev/null || true)"
    if [ -z "$recorded" ]; then
      printf 'empty\n'
    elif [[ "$recorded" =~ $RE_DIGITS ]]; then
      printf 'sum:%s\n' "$recorded"
    else
      printf 'corrupt\n'
    fi
    return 0
  fi
  printf 'none\n'
}

has_managed_ownership() {
  local state
  state="$(lookup_managed "$1" "$2" "${3:-}")"
  [ "$state" != "none" ]
}

managed_ok_key() {
  local root="$1" target="$2" key="$3" upstream="$4" legacy="${5:-}"
  [ -f "$target" ] || return 1
  local state
  state="$(lookup_managed "$root" "$key" "$legacy")"
  case "$state" in
    sum:*) [ "${state#sum:}" = "$(file_cksum "$target")" ] ;;
    empty) [ -n "$upstream" ] && [ -f "$upstream" ] && cmp -s "$target" "$upstream" ;;
    *) return 1 ;;
  esac
}

stage_managed_raw() {
  [ -n "${MANIFEST_STAGE:-}" ] || return 0
  printf '%s %s\n' "$1" "$2" >> "$MANIFEST_STAGE"
}

record_managed() {
  [ -n "${MANIFEST_STAGE:-}" ] || return 0
  printf '%s %s\n' "$(file_cksum "$1")" "$2" >> "$MANIFEST_STAGE"
}

preserve_managed() {
  [ -n "${MANIFEST_STAGE:-}" ] || return 0
  local state
  state="$(lookup_managed "$1" "$2" "${3:-}")"
  case "$state" in
    sum:*) printf '%s %s\n' "${state#sum:}" "$2" >> "$MANIFEST_STAGE" ;;
  esac
}

# Print "<cksum> <basename>" for every managed file in .workflow/bin/.
cli_manifest_entries() {
  local root="$1" vf="$1/.workflow/.workflow-version" from_vf=""
  if [ -f "$vf" ]; then
    from_vf="$(awk '
      /^managed:$/ { in_m = 1; next }
      in_m && /^[^ ]/ { in_m = 0 }
      in_m && $2 ~ /^\.workflow\/bin\/[^/]+$/ {
        k = $2; sub(/^\.workflow\/bin\//, "", k)
        print $1, k
      }
    ' "$vf")"
  fi
  if [ -n "$from_vf" ]; then
    {
      printf '%s\n' "$from_vf"
      if [ -f "$root/.workflow/bin/.workflow-managed" ]; then
        awk '$2 != "" { print $1, $2 }' "$root/.workflow/bin/.workflow-managed"
      fi
    } | awk '!seen[$2]++'
    return 0
  fi
  if [ -f "$root/.workflow/bin/.workflow-managed" ]; then
    awk '$2 != "" { print $1, $2 }' "$root/.workflow/bin/.workflow-managed"
  fi
}

install_rulebooks() {
  local root="$1" mode="${2:-init}"
  if [ "$mode" = "1" ]; then mode="force"; fi
  if [ "$mode" = "0" ]; then mode="init"; fi
  mkdir -p "$root/.workflow"
  for f in CONVENTIONS.md STYLE.md; do
    local src="$KIT/$f" target="$root/.workflow/$f" key=".workflow/$f"
    local marker="$root/.workflow/.${f%.md}.workflow-managed"
    if [ ! -e "$target" ]; then
      cp "$src" "$target"
      record_managed "$target" "$key"
      rm -f "$marker"
      ok "$f"
    elif [ "$mode" = "force" ]; then
      cp "$src" "$target"
      record_managed "$target" "$key"
      rm -f "$marker"
      ok "$f"
    elif has_managed_ownership "$root" "$key" "$marker" && managed_ok_key "$root" "$target" "$key" "$src" "$marker"; then
      if [ "$mode" = "update" ]; then
        cp "$src" "$target"
        record_managed "$target" "$key"
        rm -f "$marker"
        ok "$f"
      else
        preserve_managed "$root" "$key" "$marker"
        rm -f "$marker"
        skip "$f (already exists, left alone)"
      fi
    elif ! has_managed_ownership "$root" "$key" "$marker" && cmp -s "$target" "$src"; then
      record_managed "$target" "$key"
      rm -f "$marker"
      if [ "$mode" = "update" ]; then
        ok "$f"
      else
        skip "$f (already exists, left alone)"
      fi
    elif [ "$mode" = "init" ]; then
      preserve_managed "$root" "$key" "$marker"
      rm -f "$marker"
      warn "skipped $f: $target was edited locally and is yours to keep (use --force)"
    else
      preserve_managed "$root" "$key" "$marker"
      rm -f "$marker"
      warn "skipped $f: $target was edited locally and is yours to keep"
    fi
  done

  # technical-debt.md is user data: install once, never overwrite edits.
  install_file "$root/.workflow/technical-debt.md" "$KIT/templates/project/.workflow/technical-debt.md"
}

check_managed_file() {
  local root="$1" label="$2" target="$3" key="$4" marker="$5" upstream="$6"
  if [ ! -f "$target" ]; then
    warn "$label missing"
    return 1
  fi

  local state
  state="$(lookup_managed "$root" "$key" "$marker")"

  if [ ! -s "$target" ] || [ "$state" = "corrupt" ]; then
    warn "$label corrupt"
    return 1
  fi

  if [ "$state" != "none" ]; then
    if managed_ok_key "$root" "$target" "$key" "$upstream" "$marker"; then
      ok "$label"
      return 0
    else
      warn "$label edited"
      return 1
    fi
  else
    if [ -n "$upstream" ] && cmp -s "$target" "$upstream"; then
      ok "$label (legacy file without marker)"
      return 0
    else
      warn "$label edited"
      return 1
    fi
  fi
}


# install_skills ROOT FORCE [DEST] - DEST defaults to .agents/skills (Codex and
# other harnesses that read it); .claude/skills is the Claude Code copy.
install_skills() {
  local root="$1" force="$2" dest_rel="${3:-.agents/skills}"
  local dest="$root/$dest_rel" label="skill"
  [ "$dest_rel" = ".agents/skills" ] || label="${dest_rel%%/*} skill"
  mkdir -p "$dest"

  for name in $(skill_names); do
    local src="$KIT/skills/$name" target="$dest/$name"
    local file="$target/SKILL.md" key="$dest_rel/$name/SKILL.md" marker="$target/.workflow-managed"
    if [ -e "$file" ] && ! managed_ok_key "$root" "$file" "$key" "$src/SKILL.md" "$marker" && [ "$force" != 1 ]; then
      if ! has_managed_ownership "$root" "$key" "$marker" && cmp -s "$file" "$src/SKILL.md"; then
        record_managed "$file" "$key"
        rm -f "$marker"
        ok "$label $name"
        continue
      fi
      preserve_managed "$root" "$key" "$marker"
      rm -f "$marker"
      warn "skipped $label $name: $file was edited here and is yours to keep (use --force)"
      continue
    fi
    mkdir -p "$target"
    cp "$src/SKILL.md" "$file"
    record_managed "$file" "$key"
    rm -f "$marker"
    ok "$label $name"
  done
}

# Claude Code matches subagent tool names case-sensitively (Read, Grep, ...);
# the generic brief spells them in lowercase.
claude_agent() {
  awk '
    NR == 1 && $0 == "---" { front = 1; print; next }
    front && $0 == "---" { front = 0; print; next }
    front && /^tools:/ {
      n = split(substr($0, 7), parts, ",")
      out = ""
      for (i = 1; i <= n; i++) {
        t = parts[i]; gsub(/^[ \t]+|[ \t]+$/, "", t)
        if (t != "") t = toupper(substr(t, 1, 1)) substr(t, 2)
        out = out (out == "" ? "" : ", ") t
      }
      print "tools: " out; next
    }
    { print }
  ' "$1"
}

# install_agents ROOT FORCE [claude] - review agents into .agents/agents, or into
# .claude/agents with Claude Code tool names.
install_agents() {
  local root="$1" force="$2" flavor="${3:-}"
  local dest_rel=".agents/agents" label="agent"
  if [ "$flavor" = claude ]; then dest_rel=".claude/agents"; label=".claude agent"; fi
  local dest="$root/$dest_rel"
  mkdir -p "$dest"
  local staged; staged="$(wf_mktemp)"
  for src in "$KIT"/templates/project/.agents/agents/*.md; do
    [ -f "$src" ] || continue
    local name base target key marker upstream="$src"
    base="$(basename "$src")"
    name="$(basename "$src" .md)"
    target="$dest/$base"
    key="$dest_rel/$base"
    marker="$dest/.$name.workflow-managed"
    if [ "$flavor" = claude ]; then claude_agent "$src" > "$staged"; upstream="$staged"; fi
    if [ -e "$target" ] && ! managed_ok_key "$root" "$target" "$key" "$upstream" "$marker" && [ "$force" != 1 ]; then
      if ! has_managed_ownership "$root" "$key" "$marker" && cmp -s "$target" "$upstream"; then
        record_managed "$target" "$key"
        rm -f "$marker"
        ok "$label $name"
        continue
      fi
      preserve_managed "$root" "$key" "$marker"
      rm -f "$marker"
      warn "skipped $label $name: $target was edited here and is yours to keep (use --force)"
      continue
    fi
    cp "$upstream" "$target"
    record_managed "$target" "$key"
    rm -f "$marker"
    ok "$label $name"
  done
  rm -f "$staged"
}

# Copy the CLI into .workflow/bin so every clone of the project can run it.
# Checksums are recorded under `managed:` in .workflow/.workflow-version;
# a file edited since install is left alone unless --force.
install_cli() {
  local root="$1" force="$2"
  local dest="$root/.workflow/bin" legacy_manifest="$root/.workflow/bin/.workflow-managed"
  local name target key state recorded current prev_entries
  mkdir -p "$dest"
  prev_entries="$(cli_manifest_entries "$root")"
  for name in $(cli_files); do
    target="$dest/$name"
    key=".workflow/bin/$name"
    state="$(lookup_managed "$root" "$key")"
    recorded=""
    case "$state" in sum:*) recorded="${state#sum:}" ;; esac
    if [ -e "$target" ] && [ "$force" != 1 ] && ! cmp -s "$target" "$KIT/bin/$name"; then
      current="$(file_cksum "$target")"
      if [ "$current" != "$recorded" ]; then
        warn "skipped .workflow/bin/$name: edited here and yours to keep (use --force)"
        [ -z "$recorded" ] || stage_managed_raw "$recorded" "$key"
        continue
      fi
    fi
    cp "$KIT/bin/$name" "$target"
    case "$name" in *.bash|*.awk) chmod 644 "$target" ;; *) chmod 755 "$target" ;; esac
    record_managed "$target" "$key"
  done
  # Drop files a previous version shipped and this one does not, if unedited.
  if [ -n "$prev_entries" ]; then
    while read -r recorded name; do
      [ -n "$name" ] || continue
      grep -qx "$name" < <(cli_files) && continue
      target="$dest/$name"
      [ -f "$target" ] || continue
      if [ "$(file_cksum "$target")" = "$recorded" ]; then
        rm -f "$target"
        ok "removed .workflow/bin/$name (no longer in the toolkit)"
      else
        stage_managed_raw "$recorded" ".workflow/bin/$name"
        warn "kept .workflow/bin/$name: no longer in the toolkit, but edited locally and yours to keep"
      fi
    done <<< "$prev_entries"
  fi
  rm -f "$legacy_manifest"
  ok "CLI in .workflow/bin ($VERSION)"
}

# Is Claude Code support on for this project? --claude/--no-claude win; then
# what the last install recorded; then whether the project already uses Claude.
claude_enabled() {
  local root="$1" choice="$2" recorded=""
  case "$choice" in on) return 0 ;; off) return 1 ;; esac
  [ -f "$root/.workflow/.workflow-version" ] && recorded="$(sed -n 's/^claude: //p' "$root/.workflow/.workflow-version")"
  case "$recorded" in yes) return 0 ;; no) return 1 ;; esac
  [ -e "$root/CLAUDE.md" ] || [ -d "$root/.claude" ]
}

install_claude() {
  local root="$1" force="$2"
  install_skills "$root" "$force" ".claude/skills"
  install_agents "$root" "$force" claude
  install_marked_block "$root" "CLAUDE.md" "$KIT/templates/project/CLAUDE.md" \
    "$root/.workflow/.claude-block.workflow-managed" "$force"
}

# Prepend, replace, or leave alone the marked block in AGENTS.md.
install_agents_block() {
  install_marked_block "$1" "AGENTS.md" "$2" "$1/.workflow/.agents-block.workflow-managed" "${3:-0}" 1
}

# install_marked_block ROOT FILE SOURCE MARKER FORCE PREPEND - the same for any file
# that carries a workflow:start/end block (AGENTS.md, CLAUDE.md).
install_marked_block() {
  local root="$1" name="$2" source="$3" marker="$4" force="${5:-0}" prepend="${6:-0}"
  local file="$root/$name" key="$name#workflow-block"
  assert_symlink_safety "$root" "$file"
  assert_symlink_safety "$root" "$marker"
  local block marker_state starts ends malformed tmp output_state
  block="$(cat "$source")"

  mkdir -p "$root/.workflow"

  if [ ! -f "$file" ]; then
    printf '%s\n' "$block" > "$file"
    record_managed "$source" "$key"
    rm -f "$marker"
    ok "$name (created)"
    return 0
  fi

  marker_state="$(parse_agents_marker_state "$file")"
  read -r starts ends malformed <<< "$marker_state"

  if [ "$starts" -eq 0 ] && [ "$ends" -eq 0 ] && [ "$malformed" -eq 0 ]; then
    if [ "$prepend" = 1 ]; then
      tmp="$(wf_mktemp)"
      if ! { printf '%s\n\n' "$block"; cat "$file"; } > "$tmp"; then
        rm -f "$tmp"
        die "could not prepare the $name workflow block"
      fi
      mv "$tmp" "$file"
      record_managed "$source" "$key"
      rm -f "$marker"
      ok "$name (workflow block prepended)"
    else
      printf '\n%s\n' "$block" >> "$file"
      record_managed "$source" "$key"
      rm -f "$marker"
      ok "$name (workflow block appended)"
    fi
    return 0
  fi
  if [ "$starts" -ne 1 ] || [ "$ends" -ne 1 ] || [ "$malformed" -ne 0 ]; then
    die "$name has an incomplete or ambiguous workflow block; refusing to modify it"
  fi

  if [ "$force" != 1 ]; then
    local current_block; current_block="$(wf_mktemp)"
    awk -v s="$MARKER_START" -v e="$MARKER_END" '
      $0 == s { inside = 1 }
      inside { print }
      $0 == e { inside = 0 }
    ' "$file" > "$current_block"

    if has_managed_ownership "$root" "$key" "$marker"; then
      if ! managed_ok_key "$root" "$current_block" "$key" "$source" "$marker"; then
        rm -f "$current_block"
        preserve_managed "$root" "$key" "$marker"
        rm -f "$marker"
        warn "skipped $name: workflow block was edited locally and is yours to keep (use --force)"
        return 0
      fi
    else
      if ! cmp -s "$current_block" "$source"; then
        rm -f "$current_block"
        warn "skipped $name: workflow block was edited locally and is yours to keep (use --force)"
        return 0
      fi
    fi
    rm -f "$current_block"
  fi

  tmp="$(wf_mktemp)"
  # The block goes in through the environment: BSD awk (macOS) rejects a -v
  # value that contains newlines.
  if ! WF_BLOCK="$block" awk -v s="$MARKER_START" -v e="$MARKER_END" '
    BEGIN { repl = ENVIRON["WF_BLOCK"] }
    $0 == s { print repl; skipping = 1; next }
    $0 == e { skipping = 0; next }
    !skipping { print }
  ' "$file" > "$tmp"; then
    rm -f "$tmp"
    die "could not prepare the $name workflow block"
  fi

  output_state="$(awk -v s="$MARKER_START" -v e="$MARKER_END" '
    $0 == s { starts++ }
    $0 == e { ends++ }
    END { print starts + 0, ends + 0 }
  ' "$tmp")"
  if [ "$output_state" != "1 1" ]; then
    rm -f "$tmp"
    die "could not validate the $name workflow block"
  fi

  mv "$tmp" "$file"
  record_managed "$source" "$key"
  rm -f "$marker"
  ok "$name (workflow block updated)"
}

# The .gitattributes block (CONVENTIONS §2): decisions.md and glossary.md use
# git's union merge, so parallel branches that add entries do not conflict.
gitattributes_block() {
  printf '%s\n' "$GA_START" ".workflow/decisions.md merge=union" ".workflow/glossary.md merge=union" "$GA_END"
}

# Print "<starts> <ends>" for the workflow block markers in .gitattributes.
gitattributes_state() {
  if [ ! -f "$1" ]; then printf '0 0\n'; return 0; fi
  awk -v s="$GA_START" -v e="$GA_END" '
    $0 == s { starts++ } $0 == e { ends++ }
    END { print starts + 0, ends + 0 }
  ' "$1"
}

# Create .gitattributes with the block, append the block, or refresh it.
install_gitattributes() {
  local root="$1" file="$1/.gitattributes" state tmp
  assert_symlink_safety "$root" "$file"
  if [ ! -f "$file" ]; then
    gitattributes_block > "$file"
    ok ".gitattributes (created, union merge for decisions and glossary)"
    return 0
  fi
  state="$(gitattributes_state "$file")"
  tmp="$(wf_mktemp)"
  case "$state" in
    "0 0")
      cat "$file" > "$tmp"
      if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then printf '\n' >> "$tmp"; fi
      gitattributes_block >> "$tmp"
      ;;
    "1 1")
      WF_BLOCK="$(gitattributes_block)" awk -v s="$GA_START" -v e="$GA_END" '
        BEGIN { repl = ENVIRON["WF_BLOCK"] }
        $0 == s { print repl; skipping = 1; next }
        $0 == e { skipping = 0; next }
        !skipping { print }
      ' "$file" > "$tmp"
      ;;
    *)
      rm -f "$tmp"
      warn "skipped .gitattributes: incomplete or repeated workflow block; fix the markers by hand"
      return 0
      ;;
  esac
  if cmp -s "$tmp" "$file"; then
    rm -f "$tmp"
    skip ".gitattributes (workflow block up to date)"
  else
    cat "$tmp" > "$file"; rm -f "$tmp"
    ok ".gitattributes (workflow block written)"
  fi
}

# Take the block out of .gitattributes; delete the file if nothing else is left.
remove_gitattributes() {
  local root="$1" file="$1/.gitattributes" tmp
  [ -f "$file" ] || return 0
  [ "$(gitattributes_state "$file")" = "1 1" ] || return 0
  tmp="$(wf_mktemp)"
  awk -v s="$GA_START" -v e="$GA_END" '
    $0 == s { skipping = 1; next }
    $0 == e { skipping = 0; next }
    !skipping { print }
  ' "$file" > "$tmp"
  if grep -q '[^[:space:]]' "$tmp"; then
    cat "$tmp" > "$file"
    ok "removed the workflow block from .gitattributes"
  else
    rm -f "$file"
    ok "removed .gitattributes (only the workflow block was in it)"
  fi
  rm -f "$tmp"
}

# Write a file only if it does not exist. Never clobbers user edits.
install_file() {
  local dest="$1" src="$2"
  if [ -e "$dest" ]; then
    skip "$(basename "$dest") (already exists, left alone)"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  ok "$(basename "$dest")"
}

write_manifest() {
  local root="$1" claude="${2:-no}"
  mkdir -p "$root/.workflow"
  local tmp; tmp="$(wf_mktemp)"
  {
    printf 'version: %s\n' "$VERSION"
    printf 'installed: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'claude: %s\n' "$claude"
    printf 'skills:\n'
    for name in $(skill_names); do printf '  - %s\n' "$name"; done
    if [ -n "${MANIFEST_STAGE:-}" ] && [ -s "$MANIFEST_STAGE" ]; then
      printf 'managed:\n'
      LC_ALL=C sort -k2,2 -u "$MANIFEST_STAGE" | sed 's/^/  /'
    fi
  } > "$tmp"
  mv "$tmp" "$root/.workflow/.workflow-version"
}

# Remove managed skills and agents the toolkit no longer ships. Files without
# our ownership entry are left alone: they belong to the project.
prune_stale_files() {
  local root="$1" dest dest_rel dir file name key marker skills_expected
  skills_expected=" $(skill_names | tr '\n' ' ') "
  for dest_rel in ".agents/skills" ".claude/skills"; do
    dest="$root/$dest_rel"
    if [ -d "$dest" ]; then
      for dir in "$dest"/*/; do
        [ -d "$dir" ] || continue
        name="$(basename "$dir")"
        case "$skills_expected" in *" $name "*) continue ;; esac
        file="$dir/SKILL.md"
        key="$dest_rel/$name/SKILL.md"
        marker="$dir/.workflow-managed"
        has_managed_ownership "$root" "$key" "$marker" || continue
        if [ ! -f "$file" ]; then
          rm -f "$marker"
          rmdir "$dir" 2>/dev/null || true
        elif managed_ok_key "$root" "$file" "$key" "" "$marker"; then
          rm -f "$file" "$marker"
          rmdir "$dir" 2>/dev/null || true
          ok "removed skill $name (no longer in the toolkit)"
        else
          preserve_managed "$root" "$key" "$marker"
          rm -f "$marker"
          warn "kept skill $name: edited locally, yours to keep"
        fi
      done
    fi
  done
  local agents_expected=" "
  for file in "$KIT"/templates/project/.agents/agents/*.md; do
    [ -f "$file" ] || continue
    agents_expected="$agents_expected$(basename "$file" .md) "
  done
  for dest_rel in ".agents/agents" ".claude/agents"; do
    dest="$root/$dest_rel"
    if [ -d "$dest" ]; then
      for file in "$dest"/*.md; do
        [ -f "$file" ] || continue
        name="$(basename "$file" .md)"
        case "$agents_expected" in *" $name "*) continue ;; esac
        key="$dest_rel/$(basename "$file")"
        marker="$dest/.$name.workflow-managed"
        has_managed_ownership "$root" "$key" "$marker" || continue
        if managed_ok_key "$root" "$file" "$key" "" "$marker"; then
          rm -f "$file" "$marker"
          ok "removed agent $name (no longer in the toolkit)"
        else
          preserve_managed "$root" "$key" "$marker"
          rm -f "$marker"
          warn "kept agent $name: edited locally, yours to keep"
        fi
      done
    fi
  done
  # Framework files the toolkit no longer ships (thinking.md since 2.5).
  local f target src
  for f in $RETIRED_FRAMEWORK; do
    [ -f "$KIT/templates/project/.workflow/$f" ] && continue
    target="$root/.workflow/$f"
    key=".workflow/$f"
    marker="$root/.workflow/.${f%.md}.workflow-managed"
    src=""
    [ -f "$KIT/templates/project/.workflow/$f" ] && src="$KIT/templates/project/.workflow/$f"
    if has_managed_ownership "$root" "$key" "$marker"; then
      if [ ! -f "$target" ]; then
        rm -f "$marker"
      elif managed_ok_key "$root" "$target" "$key" "$src" "$marker"; then
        rm -f "$target" "$marker"
        ok "removed .workflow/$f (no longer in the toolkit)"
      else
        preserve_managed "$root" "$key" "$marker"
        rm -f "$marker"
        warn "kept .workflow/$f: no longer in the toolkit, but edited locally and yours to keep"
      fi
    fi
  done
  # Effort definitions are gone (2.5); drop the directory if it is empty.
  rmdir "$root/.workflow/efforts" 2>/dev/null || true
}

# ---------------------------------------------------------------- commands

parse_install_args() {
  FORCE=0; CLAUDE_CHOICE=""
  for arg in "$@"; do
    case "$arg" in
      --force) FORCE=1 ;;
      --claude) CLAUDE_CHOICE=on ;;
      --no-claude) CLAUDE_CHOICE=off ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $arg" ;;
    esac
  done
}

cmd_init() {
  parse_install_args "$@"
  local force=$FORCE
  require_kit init
  local root; root="$(project_root)"
  assert_symlink_safety "$root"
  say ""
  say "Installing the workflow into $root"
  say ""

  mkdir -p "$root/.workflow/specs" "$root/.workflow/tasks" \
           "$root/.workflow/maps" "$root/.workflow/done"
  MANIFEST_STAGE="$(wf_mktemp)"

  install_skills "$root" "$force"
  install_agents "$root" "$force"
  install_rulebooks "$root" "$force"

  for f in standards glossary decisions; do
    install_file "$root/.workflow/$f.md" "$KIT/templates/project/.workflow/$f.md"
  done

  install_agents_block "$root" "$KIT/templates/project/AGENTS.md" "$force"
  install_gitattributes "$root"
  install_cli "$root" "$force"
  local claude=no commit_paths=".workflow/, .agents/, AGENTS.md and .gitattributes"
  if claude_enabled "$root" "$CLAUDE_CHOICE"; then
    install_claude "$root" "$force"; claude=yes; commit_paths=".workflow/, .agents/, AGENTS.md, .gitattributes, .claude/ and CLAUDE.md"
  fi
  write_manifest "$root" "$claude"
  rm -f "$MANIFEST_STAGE"; MANIFEST_STAGE=""
  cat >&2 <<EOF

${C_OK}Done.${C_OFF} Next step:

  1. Fill in .workflow/standards.md, or let flow-start fill it from the repository
     on first use and confirm what it found.
  2. Commit ${commit_paths}.
     .workflow/bin/workflow is the CLI the skills call; it travels with the repo.
  3. Optional: .workflow/bin/workflow hook install, to run validate before each commit.
  4. Open your agent and ask it to grill you about what you want to build.

EOF
}

cmd_update() {
  parse_install_args "$@"
  local force=$FORCE
  require_kit update
  local root; root="$(project_root)"
  assert_symlink_safety "$root"
  say "Updating the workflow in $root"
  mkdir -p "$root/.workflow"
  MANIFEST_STAGE="$(wf_mktemp)"
  install_skills "$root" "$force"
  install_agents "$root" "$force"
  local rulebooks_mode="update"
  if [ "$force" = 1 ]; then rulebooks_mode="force"; fi
  install_rulebooks "$root" "$rulebooks_mode"
  install_agents_block "$root" "$KIT/templates/project/AGENTS.md" "$force"
  install_gitattributes "$root"
  install_cli "$root" "$force"
  local claude=no
  if claude_enabled "$root" "$CLAUDE_CHOICE"; then install_claude "$root" "$force"; claude=yes; fi
  prune_stale_files "$root"
  write_manifest "$root" "$claude"
  rm -f "$MANIFEST_STAGE"; MANIFEST_STAGE=""
  ok "updated to $VERSION"
  say "Commit these files on the main branch; other branches and worktrees keep the old rules until they merge or rebase onto it."
  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local main_name head_name
    main_name="$(main_branch "$root")"
    head_name="$(current_branch "$root")"
    if [ -n "$main_name" ] && [ "$head_name" != "$main_name" ]; then
      warn "you are on ${head_name:-a detached HEAD}, not $main_name: commit the update on $main_name first"
    fi
  fi
  say ""
  say "Your own files (standards, glossary, decisions, technical-debt, specs, tasks) were not touched."
}

# Doctor reports what is installed. Task and decision checks are not
# re-implemented here: it runs `workflow validate`, the one source of those
# rules, and counts its errors. Validate warnings (an archived file, say) are
# shown but are not install problems.
run_validate_for_doctor() {
  local root="$1" v_var="$2" out status=0
  if [ ! -f "$BIN_DIR/workflow-core.py" ]; then
    warn "workflow validate: $BIN_DIR/workflow-core.py missing; run 'workflow update'"
    bump "$v_var"; return 0
  fi
  have_python || { skip "workflow validate: skipped, python3 not found"; return 0; }
  out="$(cd "$root" && python3 "$BIN_DIR/workflow-core.py" validate --format json --no-color 2>&1)" || status=$?
  if [ "$status" -eq 0 ]; then
    ok "workflow validate: tasks and decisions are valid"
    return 0
  fi

  local counts
  counts="$(python3 -c '
import sys, json
try:
    data = json.loads(sys.argv[1])
    for issue in data.get("issues", []):
        sev = issue.get("severity", "ERROR")
        label = "Warning" if sev == "WARNING" else "Error"
        sys.stderr.write("  %s: %s:%s: %s\n    Fix: %s\n" % (
            label, issue.get("file", ""), issue.get("line", 1),
            issue.get("message", ""), issue.get("suggestion", "")))
    print("%d %d" % (data.get("errors", 0), data.get("warnings", 0)))
except Exception:
    sys.exit(1)
' "$out")" || {
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    warn "workflow validate failed to run"
    bump "$v_var"
    return 0
  }
  local errors=0 warnings=0
  read -r errors warnings <<< "$counts"
  if [ "$status" -ge 2 ]; then
    warn "workflow validate: $errors error(s), $warnings warning(s)"
    bump "$v_var" "$((errors > 0 ? errors : 1))"
  else
    skip "workflow validate: $warnings warning(s), no errors"
  fi
}

check_cli() {
  local root="$1" dest="$1/.workflow/bin" c_var="$2"
  local name recorded installed="" entries
  if [ ! -f "$dest/workflow" ]; then
    warn ".workflow/bin/workflow missing; run 'workflow update' from a toolkit checkout"
    bump "$c_var"; return 0
  fi
  installed="$(sed -n 's/^VERSION="\(.*\)"$/\1/p' "$dest/workflow" | head -n 1)"
  local edited=0
  entries="$(cli_manifest_entries "$root")"
  if [ -n "$entries" ]; then
    while read -r recorded name; do
      [ -n "$name" ] || continue
      if [ ! -f "$dest/$name" ]; then
        warn ".workflow/bin/$name missing"; bump "$c_var"
      elif [ "$(file_cksum "$dest/$name")" != "$recorded" ]; then
        warn ".workflow/bin/$name edited"; edited=1; bump "$c_var"
      fi
    done <<< "$entries"
  fi
  if [ "$VENDORED" = 0 ] && [ "$installed" != "$VERSION" ]; then
    warn ".workflow/bin is version ${installed:-unknown}, toolkit is $VERSION; run 'workflow update'"
    bump "$c_var"
  elif [ "$edited" = 0 ]; then
    ok ".workflow/bin/workflow ($installed)"
  fi
}

cmd_doctor() {
  for arg in "$@"; do
    case "$arg" in -h|--help) usage; exit 0 ;; *) die "unknown argument: $arg" ;; esac
  done
  local root; root="$(project_root)"
  assert_symlink_safety "$root"
  local problems=0
  say "Workflow check for $root"
  say ""

  if [ -f "$root/.workflow/.workflow-version" ]; then
    ok "installed: $(sed -n 's/^version: //p' "$root/.workflow/.workflow-version")"
  else
    warn "not installed here; run 'workflow init'"
    problems=$((problems + 1))
  fi

  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
     [ -f "$root/.workflow/.workflow-version" ]; then
    local main_name head_name here_version main_version changed
    main_name="$(main_branch "$root")"
    head_name="$(current_branch "$root")"
    if [ -n "$main_name" ]; then
      here_version="$(manifest_version "$root/.workflow/.workflow-version")"
      if [ "$head_name" != "$main_name" ]; then
        main_version="$(git -C "$root" show "$main_name:.workflow/.workflow-version" 2>/dev/null |
          sed -n 's/^version: //p' | head -n 1)"
        if [ -n "$here_version" ] && [ -n "$main_version" ] && [ "$main_version" != "$here_version" ]; then
          warn "this tree has workflow $here_version, $main_name has $main_version: merge $main_name into this branch, or commit the update on $main_name"
          problems=$((problems + 1))
        fi
      fi
      changed="$(git -C "$root" status --porcelain -- .workflow .agents AGENTS.md CLAUDE.md .claude .gitattributes 2>/dev/null || true)"
      if printf '%s\n' "$changed" | grep -q '\.workflow/\.workflow-version'; then
        warn "the last 'workflow update' is not committed: commit it on $main_name; other branches and worktrees keep the old rules until they merge it"
        problems=$((problems + 1))
      fi
    fi
  fi

  local skills_expected name
  skills_expected=" $(expected_skills "$root" | tr '\n' ' ') "
  for name in $skills_expected; do
    check_managed_file "$root" "skill $name" "$root/.agents/skills/$name/SKILL.md" \
      ".agents/skills/$name/SKILL.md" "$root/.agents/skills/$name/.workflow-managed" \
      "$(kit_file "$KIT/skills/$name/SKILL.md")" || problems=$((problems + 1))
  done

  local stale_dir stale_name
  for stale_dir in "$root/.agents/skills"/*/; do
    [ -d "$stale_dir" ] || continue
    stale_name="$(basename "$stale_dir")"
    case "$skills_expected" in *" $stale_name "*) continue ;; esac
    if has_managed_ownership "$root" ".agents/skills/$stale_name/SKILL.md" "$stale_dir/.workflow-managed"; then
      warn "skill $stale_name is no longer in the toolkit; run 'workflow update'"
      problems=$((problems + 1))
    fi
  done

  local agents_expected
  agents_expected=" $(expected_agents "$root" | tr '\n' ' ') "
  for name in $agents_expected; do
    check_managed_file "$root" "agent $name" "$root/.agents/agents/$name.md" \
      ".agents/agents/$name.md" "$root/.agents/agents/.$name.workflow-managed" \
      "$(kit_file "$KIT/templates/project/.agents/agents/$name.md")" || problems=$((problems + 1))
  done

  local stale_agent stale_agent_name
  for stale_agent in "$root/.agents/agents"/*.md; do
    [ -f "$stale_agent" ] || continue
    stale_agent_name="$(basename "$stale_agent" .md)"
    case "$agents_expected" in *" $stale_agent_name "*) continue ;; esac
    if has_managed_ownership "$root" ".agents/agents/$stale_agent_name.md" "$root/.agents/agents/.$stale_agent_name.workflow-managed"; then
      warn "agent $stale_agent_name is no longer in the toolkit; run 'workflow update'"
      problems=$((problems + 1))
    fi
  done

  local marker_state starts ends malformed
  marker_state="$(parse_agents_marker_state "$root/AGENTS.md")"
  read -r starts ends malformed <<< "$marker_state"
  if [ "$starts" -eq 1 ] && [ "$ends" -eq 1 ] && [ "$malformed" -eq 0 ]; then
    ok "AGENTS.md has the workflow block"
  elif [ "$starts" -eq 0 ] && [ "$ends" -eq 0 ] && [ "$malformed" -eq 0 ]; then
    warn "AGENTS.md is missing the workflow block; run 'workflow update'"
    problems=$((problems + 1))
  else
    warn "AGENTS.md has an incomplete or ambiguous workflow block; fix markers manually"
    problems=$((problems + 1))
  fi

  if claude_enabled "$root" ""; then
    for name in $skills_expected; do
      check_managed_file "$root" ".claude skill $name" "$root/.claude/skills/$name/SKILL.md" \
        ".claude/skills/$name/SKILL.md" "$root/.claude/skills/$name/.workflow-managed" \
        "$(kit_file "$KIT/skills/$name/SKILL.md")" || problems=$((problems + 1))
    done
    for name in $agents_expected; do
      check_managed_file "$root" ".claude agent $name" "$root/.claude/agents/$name.md" \
        ".claude/agents/$name.md" "$root/.claude/agents/.$name.workflow-managed" "" || problems=$((problems + 1))
    done
    marker_state="$(parse_agents_marker_state "$root/CLAUDE.md")"
    read -r starts ends malformed <<< "$marker_state"
    if [ "$starts" -eq 1 ] && [ "$ends" -eq 1 ] && [ "$malformed" -eq 0 ]; then
      ok "CLAUDE.md imports AGENTS.md"
    else
      warn "CLAUDE.md is missing the workflow block; run 'workflow update --claude'"
      problems=$((problems + 1))
    fi
  fi

  local ga_state; ga_state="$(gitattributes_state "$root/.gitattributes")"
  if [ "$ga_state" = "1 1" ] && grep -qxF '.workflow/decisions.md merge=union' "$root/.gitattributes" &&
     grep -qxF '.workflow/glossary.md merge=union' "$root/.gitattributes"; then
    ok ".gitattributes has the workflow union-merge block"
  else
    warn ".gitattributes is missing the workflow union-merge block; run 'workflow update'"
    problems=$((problems + 1))
  fi

  if have_python; then
    ok "python3 available ($(python3 -c 'import platform; print(platform.python_version())' 2>/dev/null))"
  else
    warn "python3 3.8+ not found; workflow validate and next need it"
    problems=$((problems + 1))
  fi

  check_cli "$root" problems

  for f in CONVENTIONS.md STYLE.md; do
    check_managed_file "$root" ".workflow/$f" "$root/.workflow/$f" ".workflow/$f" \
      "$root/.workflow/.${f%.md}.workflow-managed" "$(kit_file "$KIT/$f")" || problems=$((problems + 1))
  done

  for f in standards.md glossary.md decisions.md technical-debt.md; do
    [ -f "$root/.workflow/$f" ] || { warn ".workflow/$f missing"; problems=$((problems + 1)); }
  done
  if [ -f "$root/.workflow/standards.md" ] && grep -qE "$RE_STANDARDS_PLACEHOLDER" "$root/.workflow/standards.md"; then
    warn "standards.md still contains unfilled placeholders"
    problems=$((problems + 1))
  fi

  if [ -d "$root/.workflow" ]; then
    run_validate_for_doctor "$root" problems
  fi

  local hook; hook="$(hook_path "$root" 2>/dev/null || true)"
  if [ -n "$hook" ] && [ -f "$hook" ] && grep -qF "$HOOK_MARKER" "$hook"; then
    ok "pre-commit hook runs workflow validate"
  fi

  say ""
  if [ "$problems" -eq 0 ]; then
    say "${C_OK}Everything present.${C_OFF}"
    return 0
  else
    say "${C_WARN}$problems problem(s) found.${C_OFF} Follow the diagnostics above to fix them."
    return 1
  fi
}

# remove_marked_block ROOT FILE SOURCE MARKER COUNTER - take the workflow block
# out of AGENTS.md or CLAUDE.md if it is unedited; keep the rest of the file.
remove_marked_block() {
  local root="$1" name="$2" agents_src="$3" agents_marker="$4"
  local agents_file="$root/$name" key="$name#workflow-block"

  if [ -f "$agents_file" ]; then
    local agents_preexisting_empty=0
    [ -s "$agents_file" ] || agents_preexisting_empty=1

    if [ "$agents_preexisting_empty" -eq 1 ]; then
      rm -f "$agents_marker"
    else
      local marker_state starts ends malformed
      marker_state="$(parse_agents_marker_state "$agents_file")"
      read -r starts ends malformed <<< "$marker_state"

      if [ "$starts" -eq 0 ] && [ "$ends" -eq 0 ] && [ "$malformed" -eq 0 ]; then
        rm -f "$agents_marker"
      elif [ "$starts" -ne 1 ] || [ "$ends" -ne 1 ] || [ "$malformed" -ne 0 ]; then
        warn "kept $name: ambiguous or malformed workflow block, yours to keep"
      else
        local current_block; current_block="$(wf_mktemp)"
        awk -v s="$MARKER_START" -v e="$MARKER_END" '
          $0 == s { inside = 1 }
          inside { print }
          $0 == e { inside = 0 }
        ' "$agents_file" > "$current_block"

        local block_unmodified=0
        if has_managed_ownership "$root" "$key" "$agents_marker"; then
          if managed_ok_key "$root" "$current_block" "$key" "$agents_src" "$agents_marker"; then
            block_unmodified=1
          fi
        else
          if cmp -s "$current_block" "$agents_src"; then
            block_unmodified=1
          fi
        fi
        rm -f "$current_block"

        if [ "$block_unmodified" -eq 1 ]; then
          local tmp; tmp="$(wf_mktemp)"
          awk -v s="$MARKER_START" -v e="$MARKER_END" '
            $0 == s { skipping = 1; next }
            $0 == e { skipping = 0; next }
            !skipping { print }
          ' "$agents_file" > "$tmp"
          mv "$tmp" "$agents_file"
          rm -f "$agents_marker"
          ok "removed the workflow block from $name"

          # Only delete if successful workflow block removal made it empty
          if [ -f "$agents_file" ] && [ ! -s "$agents_file" ]; then
            rm "$agents_file"
            ok "removed the empty $name"
          fi
        else
          rm -f "$agents_marker"
          warn "kept $name: workflow block was edited locally, yours to keep"
        fi
      fi
    fi
  else
    rm -f "$agents_marker"
  fi
}

# Remove the copied CLI, keeping files edited since install.
remove_cli() {
  local root="$1" dest="$1/.workflow/bin" legacy_manifest="$1/.workflow/bin/.workflow-managed"
  local entries recorded name
  entries="$(cli_manifest_entries "$root")"
  [ -n "$entries" ] || [ -f "$legacy_manifest" ] || return 0
  if [ -n "$entries" ]; then
    while read -r recorded name; do
      [ -n "$name" ] && [ -f "$dest/$name" ] || continue
      if [ "$(file_cksum "$dest/$name")" = "$recorded" ]; then
        rm -f "$dest/$name"
      else
        warn "kept .workflow/bin/$name: edited locally, yours to keep"
      fi
    done <<< "$entries"
  fi
  rm -f "$legacy_manifest"
  rmdir "$dest" 2>/dev/null || true
  ok "removed .workflow/bin"
}

cmd_uninstall() {
  for arg in "$@"; do
    case "$arg" in -h|--help) usage; exit 0 ;; *) die "unknown argument: $arg" ;; esac
  done
  require_kit uninstall
  local root; root="$(project_root)"
  assert_symlink_safety "$root"
  local removed=0

  for name in $(skill_names); do
    local target="$root/.agents/skills/$name"
    local file="$target/SKILL.md" key=".agents/skills/$name/SKILL.md" marker="$target/.workflow-managed"
    if managed_ok_key "$root" "$file" "$key" "$KIT/skills/$name/SKILL.md" "$marker"; then
      rm -f "$file" "$marker"; rmdir "$target" 2>/dev/null || true
      ok "removed skill $name"; removed=$((removed + 1))
    elif [ -f "$file" ]; then
      rm -f "$marker"
      warn "kept .agents/skills/$name/SKILL.md: edited locally, yours to keep"
    fi
  done

  for src in "$KIT"/templates/project/.agents/agents/*.md; do
    [ -f "$src" ] || continue
    local name base a key marker
    base="$(basename "$src")"
    name="$(basename "$src" .md)"
    a="$root/.agents/agents/$base"
    key=".agents/agents/$base"
    marker="$root/.agents/agents/.$name.workflow-managed"
    if managed_ok_key "$root" "$a" "$key" "$src" "$marker"; then
      rm -f "$a" "$marker"; ok "removed agent $name"; removed=$((removed + 1))
    elif [ -f "$a" ]; then
      rm -f "$marker"
      warn "kept .agents/agents/$base: edited locally, yours to keep"
    fi
  done
  # Claude Code copies: same ownership rule, keyed on the recorded checksum.
  for name in $(skill_names); do
    local target="$root/.claude/skills/$name"
    local file="$target/SKILL.md" key=".claude/skills/$name/SKILL.md" marker="$target/.workflow-managed"
    if has_managed_ownership "$root" "$key" "$marker" && managed_ok_key "$root" "$file" "$key" "$KIT/skills/$name/SKILL.md" "$marker"; then
      rm -f "$file" "$marker"; rmdir "$target" 2>/dev/null || true
      ok "removed .claude skill $name"; removed=$((removed + 1))
    elif [ -f "$file" ] && has_managed_ownership "$root" "$key" "$marker"; then
      rm -f "$marker"
      warn "kept .claude/skills/$name/SKILL.md: edited locally, yours to keep"
    fi
  done
  for src in "$KIT"/templates/project/.agents/agents/*.md; do
    [ -f "$src" ] || continue
    local name a key marker
    name="$(basename "$src" .md)"
    a="$root/.claude/agents/$name.md"
    key=".claude/agents/$name.md"
    marker="$root/.claude/agents/.$name.workflow-managed"
    if has_managed_ownership "$root" "$key" "$marker" && managed_ok_key "$root" "$a" "$key" "" "$marker"; then
      rm -f "$a" "$marker"; ok "removed .claude agent $name"; removed=$((removed + 1))
    elif [ -f "$a" ] && has_managed_ownership "$root" "$key" "$marker"; then
      rm -f "$marker"
      warn "kept .claude/agents/$name.md: edited locally, yours to keep"
    fi
  done
  prune_stale_files "$root"
  rmdir "$root/.agents/agents" 2>/dev/null || true
  rmdir "$root/.agents/skills" 2>/dev/null || true
  rmdir "$root/.agents" 2>/dev/null || true
  rmdir "$root/.claude/agents" 2>/dev/null || true
  rmdir "$root/.claude/skills" 2>/dev/null || true
  rmdir "$root/.claude" 2>/dev/null || true

  # Rulebooks: remove if unedited, keep if edited.
  for f in CONVENTIONS.md STYLE.md; do
    local target="$root/.workflow/$f" key=".workflow/$f"
    local marker="$root/.workflow/.${f%.md}.workflow-managed"
    [ -e "$target" ] || [ -e "$marker" ] || has_managed_ownership "$root" "$key" "$marker" || continue
    local src=""
    [ -f "$KIT/$f" ] && src="$KIT/$f"
    if has_managed_ownership "$root" "$key" "$marker" && managed_ok_key "$root" "$target" "$key" "$src" "$marker"; then
      rm -f "$target" "$marker"
      ok "removed .workflow/$f"
      removed=$((removed + 1))
    elif ! has_managed_ownership "$root" "$key" "$marker" && [ -f "$target" ] && [ -n "$src" ] && cmp -s "$target" "$src"; then
      rm -f "$target"
      ok "removed .workflow/$f"
      removed=$((removed + 1))
    else
      rm -f "$marker"
      if [ -f "$target" ]; then
        warn "kept .workflow/$f: edited locally, yours to keep"
      fi
    fi
  done
  for d in specs tasks maps done; do
    rmdir "$root/.workflow/$d" 2>/dev/null || true
  done

  remove_marked_block "$root" AGENTS.md "$KIT/templates/project/AGENTS.md" \
    "$root/.workflow/.agents-block.workflow-managed" removed
  if [ -f "$root/CLAUDE.md" ] || has_managed_ownership "$root" "CLAUDE.md#workflow-block" "$root/.workflow/.claude-block.workflow-managed"; then
    remove_marked_block "$root" CLAUDE.md "$KIT/templates/project/CLAUDE.md" \
      "$root/.workflow/.claude-block.workflow-managed" removed
  fi
  remove_cli "$root" removed
  if [ -f "$root/.workflow/.workflow-version" ]; then
    rm -f "$root/.workflow/.workflow-version"
    ok "removed .workflow/.workflow-version"
    removed=$((removed + 1))
  fi
  remove_gitattributes "$root"
  local hook; hook="$(hook_path "$root" 2>/dev/null || true)"
  if [ -n "$hook" ] && [ -f "$hook" ] && grep -qF "$HOOK_MARKER" "$hook"; then
    remove_hook_file_or_block "$hook"
  fi
  say ""
  say "Removed $removed file(s)."
  say "Your own files are untouched: .workflow/standards.md, glossary.md,"
  say "decisions.md, technical-debt.md, specs/, tasks/, maps/ and done/."
  if [ -d "$root/.workflow" ] && [ -z "$(ls -A "$root/.workflow")" ]; then
    rmdir "$root/.workflow"
  fi
  say "Delete whatever is left of .workflow/ if you want it gone."
}

# Where git looks for this repository's pre-commit hook (honours core.hooksPath).
hook_path() {
  local root="$1" dir
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || return 1
  dir="$(git -C "$root" rev-parse --git-path hooks)"
  case "$dir" in /*) ;; *) dir="$root/$dir" ;; esac
  printf '%s/pre-commit\n' "$dir"
}

hook_body() {
  cat <<'EOF'
root=$(git rev-parse --show-toplevel) || exit 1
cli="$root/.workflow/bin/workflow"
if [ ! -f "$cli" ]; then
  echo "workflow validate unavailable: missing $cli. Restore it or run 'workflow hook uninstall' from a toolkit checkout." >&2
  exit 1
fi
bash "$cli" validate --staged --no-color
if [ $? -ge 2 ]; then
  echo "workflow validate found errors or could not run. Fix them, or commit with --no-verify to skip." >&2
  exit 1
fi
EOF
}

hook_script() {
  cat <<'EOF'
#!/bin/sh
# workflow:pre-commit - written by `workflow hook install`; remove with
# `.workflow/bin/workflow hook uninstall`. Validation errors and unavailable
# validation block the commit; warnings pass.
EOF
  hook_body
  printf 'exit 0\n'
}

hook_block() {
  printf '%s\n' "$HOOK_BLOCK_START"
  hook_body
  printf '%s\n' "$HOOK_BLOCK_END"
}

append_hook_block() {
  local hook="$1" tmp block_file
  tmp="$(wf_mktemp)"
  block_file="$(wf_mktemp)"
  hook_block > "$block_file"
  if grep -qxF "$HOOK_BLOCK_START" "$hook" && grep -qxF "$HOOK_BLOCK_END" "$hook"; then
    awk -v s="$HOOK_BLOCK_START" -v e="$HOOK_BLOCK_END" -v bf="$block_file" '
      $0 == s {
        while ((getline line < bf) > 0) print line
        close(bf)
        skipping = 1
        next
      }
      $0 == e { skipping = 0; next }
      !skipping { print }
    ' "$hook" > "$tmp"
  else
    awk -v bf="$block_file" '
      { lines[NR] = $0 }
      END {
        insert_before = 0
        for (i = NR; i >= 1; i--) {
          if (lines[i] ~ /^[[:space:]]*$/) continue
          if (lines[i] ~ /^[[:space:]]*exit([[:space:]]+0)?[[:space:]]*$/) insert_before = i
          break
        }
        for (i = 1; i <= NR; i++) {
          if (i == insert_before) {
            while ((getline line < bf) > 0) print line
            close(bf)
          }
          print lines[i]
        }
        if (insert_before == 0) {
          while ((getline line < bf) > 0) print line
          close(bf)
        }
      }
    ' "$hook" > "$tmp"
  fi
  mv "$tmp" "$hook"
  chmod +x "$hook"
  rm -f "$block_file"
}

remove_hook_file_or_block() {
  local hook="$1"
  if grep -qxF "$HOOK_BLOCK_START" "$hook" && grep -qxF "$HOOK_BLOCK_END" "$hook"; then
    local tmp; tmp="$(wf_mktemp)"
    awk -v s="$HOOK_BLOCK_START" -v e="$HOOK_BLOCK_END" '
      $0 == s { skipping = 1; next }
      $0 == e { skipping = 0; next }
      !skipping { print }
    ' "$hook" > "$tmp"
    mv "$tmp" "$hook"
    ok "removed workflow block from pre-commit hook"
  else
    rm -f "$hook"
    ok "pre-commit hook removed"
  fi
}

cmd_hook() {
  local action="${1:-status}" force=0 append=0
  [ "$#" -gt 0 ] && shift
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      --append) append=1 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $arg" ;;
    esac
  done
  local root hook; root="$(project_root)"
  hook="$(hook_path "$root")" || die "not a git repository: $root"
  case "$action" in
    install)
      mkdir -p "$(dirname "$hook")"
      if [ -f "$hook" ] && [ "$force" != 1 ]; then
        if [ "$append" = 1 ] || grep -qxF "$HOOK_BLOCK_START" "$hook"; then
          append_hook_block "$hook"
          ok "pre-commit hook updated (appended block): $hook"
          say "Commits are blocked when workflow validate reports errors; warnings pass."
          return 0
        elif ! grep -qF "$HOOK_MARKER" "$hook"; then
          die "$hook already exists and is not ours; use --append to add workflow validate to it, or --force to replace it"
        fi
      fi
      hook_script > "$hook"
      chmod +x "$hook"
      ok "pre-commit hook installed: $hook"
      say "Commits are blocked when workflow validate reports errors; warnings pass."
      ;;
    uninstall)
      if [ -f "$hook" ] && grep -qF "$HOOK_MARKER" "$hook"; then
        remove_hook_file_or_block "$hook"
      elif [ -f "$hook" ]; then
        warn "kept $hook: not written by workflow"
      else
        skip "no pre-commit hook installed"
      fi
      ;;
    status)
      if [ -f "$hook" ] && grep -qF "$HOOK_MARKER" "$hook"; then ok "pre-commit hook installed: $hook"
      elif [ -f "$hook" ]; then say "pre-commit hook exists but was not written by workflow: $hook"
      else say "no pre-commit hook; run 'workflow hook install'"; fi
      ;;
    -h|--help) usage ;;
    *) die "unknown hook action: $action (install, uninstall, status)" ;;
  esac
}

usage() {
  cat <<EOF
workflow $VERSION - a project workflow for coding agents

Setup (from a toolkit checkout):
  workflow init [--force] [--claude|--no-claude]    install into the current project
  workflow update [--force] [--claude|--no-claude]  re-copy skills, rules and CLI
  workflow uninstall           remove the installed skills, agents, rulebook and CLI

Anywhere, including the project's own copy, .workflow/bin/workflow:
  workflow doctor              report what is installed and what is missing
  workflow hook install|uninstall|status [--force|--append]
                               pre-commit hook that blocks on validate errors
  workflow validate [--strict] [--audit] [--staged] [--format text|json]
                               check task files and the decision log
  workflow next [--effort SLUG] [--all] [--brief] [--format text|json]
                               ready tasks by priority, then paused and blocked
  workflow task start <task>   activate a task, record Base commit and update spec
  workflow task archive <task> verify proof and move a finished task to done/
  workflow version             print the version
Commands support --help. validate, next and task need python3 (3.8+).

Installs into the nearest git repository above the current directory, or the
current directory if there is no git repository. Nothing is written outside that
project. Symlinks escaping that project are rejected. Skills are copied into
.agents/skills/, rules go into AGENTS.md between workflow:start/end markers, and
the CLI into .workflow/bin/. --claude also writes .claude/skills/,
.claude/agents/ and a CLAUDE.md that imports AGENTS.md; it is on by default when
the project already has CLAUDE.md or .claude/. A block in .gitattributes gives
.workflow/decisions.md and glossary.md git's union merge.
EOF
}

# validate, next and task live in workflow-core.py beside this script.
run_core() {
  local core="$BIN_DIR/workflow-core.py"
  [ -f "$core" ] || {
    printf "Error: missing %s; run 'workflow update' from a toolkit checkout (%s)\n" "$core" "$TOOLKIT_URL" >&2
    return 2
  }
  have_python || {
    printf 'Error: workflow %s needs python3 (3.8+) on PATH; install it and retry\n' "$1" >&2
    return 2
  }
  exec python3 "$core" "$@"
}

# Removed commands: say what to do instead, exit 2.
removed_command() {
  if [ "$1" = "pulse" ]; then
    printf "workflow pulse was removed: run 'workflow next --brief'\n" >&2
    exit 2
  fi
  local hint
  case "$1" in
    tasks) hint="run 'workflow next', or read .workflow/tasks/*/ directly" ;;
    deps) hint="read 'Blocked by' in the task files; 'workflow next' lists blocked tasks" ;;
    decisions) hint="read the end of .workflow/decisions.md, or grep -n -i '<term>' .workflow/decisions.md" ;;
    effort) hint="an effort is its tasks/<effort>/ directory plus .workflow/specs/<effort>.md" ;;
    debt) hint="read or grep .workflow/technical-debt.md" ;;
    *) hint="the hotfix's follow-up task tracks it; see 'workflow next'" ;;
  esac
  printf 'workflow %s was removed in 2.5: %s\n' "$1" "$hint" >&2
  exit 2
}


case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  update) shift; cmd_update "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  hook) shift; cmd_hook "$@" ;;
  version|--version|-v) printf '%s\n' "$VERSION" ;;
  ""|-h|--help|help) usage ;;
  validate|next|task) run_core "$@" ;;
  pulse|tasks|deps|decisions|effort|debt|hotfix-review) removed_command "$1" ;;
  *) die "unknown command: $1 (try 'workflow help')" ;;
esac
