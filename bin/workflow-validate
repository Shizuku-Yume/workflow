#!/usr/bin/env bash
# Validate workflow metadata; only confirmed CRLF repairs change files.
set -euo pipefail
KIT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/workflow-lib.bash"
source "$KIT_LIB"
ROOT=$(wf_project_root)
WF="$ROOT/.workflow"
FIX=0 STRICT=0 FORMAT=text ERRORS=0 WARNINGS=0
ISSUES=() FILES=() FIX_FILES=()
declare -A NUMBER=() EFFORT=() FIELD=() LINE=() INDEX=() ACTIVE=() DONE_FILE=() EDGES=() STATE=() DIR_EFFORT=() TITLE_NUMBER=()
C_RED= C_YELLOW= C_BLUE= C_OFF=
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'; C_OFF=$'\033[0m'
fi
usage() {
  cat <<'EOF'
workflow validate - validate the entire workflow structure

Usage: workflow validate [--fix] [--strict] [--format text|json] [--no-color]
Checks required Task, Effort, Check and Blocked by fields; effort references;
that a task in tasks/<effort>/ says the same Effort; that the heading number
matches the filename; blockers; Base commit refs; task-number collisions within
efforts; dependency cycles; and decision format. Checks active and completed
task files; problems in completed files warn instead of failing.

  --fix        Confirm each safe CRLF-to-LF repair (no semantic edits)
  --strict     Treat warnings as errors
  --format F   Output text (default) or JSON
  --no-color   Disable color output
  --help       Show help

Exit: 0 = valid, 1 = warnings, 2 = errors (including usage errors).
Examples:
  workflow validate
  workflow validate --strict --no-color
  workflow validate --format json
  workflow validate --fix
EOF
}
json_string() {
  printf '%s' "$1" | LC_ALL=C awk 'BEGIN { ORS=""; printf "\"" } { if (NR>1) printf "\\n"; for(i=1;i<=length($0);i++){c=substr($0,i,1); if(c=="\\") printf "\\\\"; else if(c=="\"") printf "\\\""; else if(c=="\t") printf "\\t"; else if(c=="\r") printf "\\r"; else if(c ~ /[[:cntrl:]]/) printf "?"; else printf "%s",c } } END {printf "\""}'
}
issue() {
  local kind=$1 file=$2 line=${3:-1} message=$4 suggestion=$5
  [ "$kind" = ERROR ] && ERRORS=$((ERRORS+1))
  [ "$kind" = WARNING ] && WARNINGS=$((WARNINGS+1))
  ISSUES+=("$(printf '%s\t%s\t%s\t%s\t%s' "$kind" "${file#"$ROOT/"}" "$line" "$message" "$suggestion")")
}
# Completed tasks are history: their content problems warn instead of blocking.
# Collisions and dependency cycles remain errors everywhere.
sev_for() {
  if [[ "$1" == "$WF/done/"* ]]; then printf 'WARNING\n'; else printf 'ERROR\n'; fi
}
collect_tasks() {
  local directory f filename key name dup
  for directory in "$WF/tasks" "$WF/done"; do
    [ -d "$directory" ] || continue
    wf_task_files "$directory"
    for f in "${WF_FILES[@]}"; do
      filename=${f##*/}
      [[ "$filename" =~ ^([0-9]+)-.+\.md$ ]] || continue
      wf_normalize_number "${BASH_REMATCH[1]}"
      NUMBER["$f"]="$WF_NUMBER"
      FILES+=("$f")
      if [[ "$f" == "$WF/done/"* ]]; then DONE_FILE["$f"]=1; fi
      wf_dir_effort "$directory" "$f"; DIR_EFFORT["$f"]="$WF_DIR_EFFORT"
      wf_read_fields "$f"
      TITLE_NUMBER["$f"]="$WF_TITLE_NUMBER"
      for name in "${!WF_FIELD[@]}"; do
        FIELD["$f|$name"]="${WF_FIELD[$name]}"
        LINE["$f|$name"]="${WF_LINE[$name]:-1}"
      done
      if [ -n "$WF_TITLE" ]; then
        FIELD["$f|Task"]="$WF_TITLE"; LINE["$f|Task"]=1
      fi
      for dup in "${WF_DUP_LINES[@]:-}"; do
        [ -n "$dup" ] || continue
        issue "$(sev_for "$f")" "$f" "${dup%%:*}" "duplicate ${dup#*:} field" "Keep one ${dup#*:} field."
      done
      EFFORT["$f"]="${FIELD["$f|effort"]:-}"
      wf_ref "${EFFORT[$f]}" "${NUMBER[$f]}"; key=$WF_REF
      if [ -z "${INDEX[$key]:-}" ]; then INDEX["$key"]="$f"; fi
      if [[ "$f" == "$WF/tasks/"* ]]; then ACTIVE["$key"]=1; fi
    done
  done
}
# The directory a task sits in names its effort; the Effort field must agree,
# or the archive move and `<effort>/<NN>` references point at the wrong place.
validate_layout() {
  local f dir effort title_number
  for f in "${FILES[@]}"; do
    dir=${DIR_EFFORT[$f]}; effort=${EFFORT[$f]}
    if [ -n "$dir" ] && [ -n "$effort" ] && [ "$dir" != "$effort" ]; then
      issue "$(sev_for "$f")" "$f" "${LINE["$f|effort"]:-1}" "task is under ${dir}/ but its Effort is '$effort'" "Move it to the $effort/ directory or correct the Effort field."
    fi
    title_number=${TITLE_NUMBER[$f]}
    if [ -n "$title_number" ] && [ "$title_number" != "${NUMBER[$f]}" ]; then
      issue "$(sev_for "$f")" "$f" 1 "heading number $title_number does not match filename number ${NUMBER[$f]}" "Make the '# NN:' heading and the filename use the same number."
    fi
  done
}
validate_required_fields() {
  local f name key value line
  for f in "${FILES[@]}"; do
    for name in Task Effort Check 'Blocked by'; do
      case "$name" in
        Task) value="${FIELD["$f|Task"]:-${FIELD["$f|task"]:-}}"; line="${LINE["$f|Task"]:-${LINE["$f|task"]:-1}}" ;;
        *) key="${name,,}"; value=${FIELD["$f|$key"]:-}; line=${LINE["$f|$key"]:-1} ;;
      esac
      if [ -z "$value" ]; then
        issue "$(sev_for "$f")" "$f" "$line" "missing or empty required $name field" "Add a nonempty $name field (Task may be '# NN: title'; Check may be a section)."
      fi
    done
  done
}
validate_task_types() {
  local f value
  for f in "${FILES[@]}"; do
    value=${FIELD["$f|task type"]:-}
    [ -z "$value" ] || case "$value" in feature|bugfix|spike|refactor) ;; *) issue "$(sev_for "$f")" "$f" "${LINE["$f|task type"]:-1}" "invalid Task type '$value'" 'Use feature, bugfix, spike, or refactor.' ;; esac
  done
}
validate_efforts() {
  local f effort
  for f in "${FILES[@]}"; do
    effort=${EFFORT[$f]}; [ -n "$effort" ] || continue
    if ! [[ "$effort" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then issue "$(sev_for "$f")" "$f" "${LINE["$f|effort"]:-1}" "invalid effort slug '$effort'" 'Use lowercase letters, digits and hyphens.'
    elif [ ! -f "$WF/efforts/$effort.md" ]; then issue WARNING "$f" "${LINE["$f|effort"]:-1}" "effort definition missing: '$effort'" "Run: workflow effort create $effort"; fi
  done
}
validate_collisions() {
  local f key; declare -A seen=()
  for f in "${FILES[@]}"; do
    wf_ref "${EFFORT[$f]}" "${NUMBER[$f]}"; key=$WF_REF
    if [ -n "${seen[$key]:-}" ]; then issue ERROR "$f" 1 "task-number collision: $key also occurs in ${seen[$key]#"$ROOT/"}" 'Renumber one task and update its blocker references.'
    else seen["$key"]=$f; fi
  done
}
validate_blockers() {
  local f blocked rc key ref raw i
  for f in "${FILES[@]}"; do
    blocked=${FIELD["$f|blocked by"]:-}
    [ -n "$blocked" ] || continue
    wf_ref "${EFFORT[$f]}" "${NUMBER[$f]}"; key=$WF_REF
    rc=0
    wf_parse_blockers "$blocked" 0 || rc=$?
    if [ "$rc" -ne 0 ]; then
      if [ "$WF_TRAILING_COMMA" -eq 1 ]; then
        issue "$(sev_for "$f")" "$f" "${LINE["$f|blocked by"]:-1}" 'malformed blocker: trailing comma' 'Use NN or effort/NN, comma-separated, or None.'
      fi
      issue "$(sev_for "$f")" "$f" "${LINE["$f|blocked by"]:-1}" "malformed blocker '${WF_BAD}'" 'Use NN or effort/NN, comma-separated, or None.'
      continue
    fi
    for ((i = 0; i < WF_REFS_COUNT; i++)); do
      ref="${WF_REFS[$i]}"; raw="${WF_RAW_REFS[$i]}"
      local target
      if [[ "$ref" == */* ]]; then wf_ref "${ref%%/*}" "${ref##*/}"
      else wf_ref "${EFFORT[$f]}" "$ref"; fi
      target=$WF_REF
      if [ -z "${INDEX[$target]:-}" ]; then
        issue "$(sev_for "$f")" "$f" "${LINE["$f|blocked by"]:-1}" "orphaned blocker '$raw'" "Create task $target or correct the Blocked by reference."
      elif [ -n "${ACTIVE[$key]:-}" ] && [ -n "${ACTIVE[$target]:-}" ]; then EDGES["$key"]="${EDGES[$key]:-} $target"; fi
    done
  done
}
validate_bases() {
  local f base state
  for f in "${FILES[@]}"; do
    base=${FIELD["$f|base commit"]:-}
    state=$(wf_base_commit_state "$ROOT" "$base")
    case "$state" in
      unresolved) issue "$(sev_for "$f")" "$f" "${LINE["$f|base commit"]:-1}" "invalid Base commit '$base'" 'Use an existing git commit ref, or <commit-sha> for drafts.' ;;
    esac
  done
}
cycle_visit() {
  local node=$1 path=$2 target f
  STATE["$node"]=1
  for target in ${EDGES[$node]:-}; do
    if [ "${STATE[$target]:-0}" = 1 ]; then f=${INDEX[$node]}; issue ERROR "$f" "${LINE["$f|blocked by"]:-1}" "circular dependency: $path -> $target" 'Remove or change one blocker in the cycle.'
    elif [ "${STATE[$target]:-0}" = 0 ]; then cycle_visit "$target" "$path -> $target"; fi
  done
  STATE["$node"]=2
}
validate_cycles() {
  local node
  for node in "${!ACTIVE[@]}"; do if [ "${STATE[$node]:-0}" = 0 ]; then cycle_visit "$node" "$node"; fi; done
}
validate_decisions() {
  local file="$WF/decisions.md" line message suggestion
  if [ ! -f "$file" ]; then issue WARNING "$file" 1 'decision log is missing' 'Create .workflow/decisions.md with ## Entries.'; return; fi
  while IFS=$'\t' read -r line message suggestion; do issue ERROR "$file" "$line" "$message" "$suggestion"; done < <(awk '
    function trim(s){sub(/^[ \t]+/,"",s);sub(/[ \t\r]+$/,"",s);return s}
    function err(n,m,s){print n "\t" m "\t" s}
    function finish( i,k){if(!entry)return;for(i=1;i<=5;i++){k=names[i];if(!values[k])err(start,"missing or empty decision field " k,"Add - **" k ":** meaningful content.")}}
    function validdate(s,base,y,m,d,days,t,h,min,sec,off){
      base=s;sub(/T.*/,"",base)
      if(base !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)return 0
      y=substr(base,1,4)+0;m=substr(base,6,2)+0;d=substr(base,9,2)+0
      if(m<1 || m>12)return 0
      days=(m==2?28+(y%4==0 && (y%100!=0 || y%400==0)):(m==4 || m==6 || m==9 || m==11?30:31))
      if(d<1 || d>days)return 0
      if(s==base)return 1
      if(s !~ /^[0-9-]+T[0-9][0-9]:[0-9][0-9](:[0-9][0-9](\.[0-9]+)?)?(Z|[+-][0-9][0-9]:[0-9][0-9])?$/)return 0
      t=substr(s,12);h=substr(t,1,2)+0;min=substr(t,4,2)+0;sec=(substr(t,6,1)==":"?substr(t,7,2)+0:0)
      if(h>23 || min>59 || sec>59)return 0
      if(match(t,/[+-]/)){off=substr(t,RSTART+1);if(substr(off,1,2)+0>23 || substr(off,4,2)+0>59)return 0}
      return 1
    }
    BEGIN{names[1]="Decided";names[2]="Instead of";names[3]="Because";names[4]="Mine";names[5]="Revisit when"}
    {s=$0;sub(/\r$/,"",s)
      if(comment){if(s ~ /-->/)comment=0;next}
      if(s ~ /<!--/){if(s !~ /-->/)comment=1;next}
      if(s ~ /^[ \t]*(```|~~~)/){fence=!fence;next}
      if(fence)next
      if(s ~ /^##[ \t]+Entries[ \t]*$/){finish();entries=1;entry=0;next}
      if(!entries)next
      if(s ~ /^##[ \t]+[^#]/){finish();entry=1;start=NR;delete values;delete seen;pending="";title=s;sub(/^##[ \t]+/,"",title);date=title;sub(/[ \t].*$/,"",date);if(!validdate(date) || title !~ /^[^ \t]+[ \t]+-[ \t]+[^ \t]/)err(NR,"malformed decision heading","Use ## ISO-date - title with a valid ISO8601 date or timestamp.");next}
      if(!entry){if(s ~ /^[ \t]*-[ \t]+\*\*(Decided|Instead of|Because|Mine|Revisit when):/)err(NR,"decision field outside an entry","Add ## ISO-date - title above it.");next}
      v=s;gsub(/\*\*/,"",v);sub(/^[ \t]*-[ \t]+/,"",v);k=v;sub(/:.*/,"",k)
      if(k=="Decided" || k=="Instead of" || k=="Because" || k=="Mine" || k=="Revisit when"){
        if(seen[k]++)err(NR,"duplicate decision field " k,"Keep one " k " field per entry.")
        sub(/^[^:]*:[ \t]*/,"",v);v=trim(v);values[k]=(v!="");pending=k
        if(k=="Mine" && v !~ /^(yes|no)([ \t.(]|$)/)err(NR,"invalid Mine field","Use yes for agent decisions, no for user decisions.")
      }else if(pending!="" && s ~ /^[ \t]+[^ \t]/)values[pending]=1
      else if(trim(s)!="")pending=""
    }
    END{finish();if(!entries)err(1,"missing ## Entries section","Add ## Entries before the decision log.")}
  ' "$file")
}
validate_line_endings() {
  local f line; local -a candidates=("${FILES[@]}")
  if [ -f "$WF/decisions.md" ]; then candidates+=("$WF/decisions.md"); fi
  for f in "${candidates[@]}"; do
    line=$(awk '/\r$/{print NR;exit}' "$f")
    if [ -n "$line" ]; then issue WARNING "$f" "$line" 'CRLF line endings' 'Run: workflow validate --fix (asks before converting to LF).'; FIX_FILES+=("$f"); fi
  done
}
apply_fixes() {
  local f answer temp
  for f in "${FIX_FILES[@]}"; do
    printf 'Convert CRLF to LF in %s? [y/N] ' "${f#"$ROOT/"}" >&2
    if ! IFS= read -r answer; then answer=; printf '\n' >&2; fi
    case $answer in y|Y|yes|YES)
      if [ -L "$f" ]; then printf 'Error: refusing to replace symlink %s\n' "$f" >&2; continue; fi
      if ! temp=$(mktemp "${f}.validate.XXXXXX"); then printf 'Error: cannot create repair file for %s\n' "$f" >&2; continue; fi
      if awk '{sub(/\r$/,"");print}' "$f" > "$temp" && cat "$temp" > "$f"; then printf '%sINFO%s %s: converted CRLF to LF\n' "$C_BLUE" "$C_OFF" "${f#"$ROOT/"}" >&2
      else printf 'Error: could not repair %s\n' "$f" >&2; fi
      rm -f "$temp"
    ;; esac
  done
}
run_validation() {
  ERRORS=0; WARNINGS=0; ISSUES=(); FILES=(); FIX_FILES=()
  NUMBER=(); EFFORT=(); FIELD=(); LINE=(); INDEX=(); ACTIVE=(); DONE_FILE=(); EDGES=(); STATE=(); DIR_EFFORT=(); TITLE_NUMBER=()
  if [ ! -d "$WF" ]; then issue ERROR "$WF" 1 'missing .workflow directory' 'Run: workflow init'; return; fi
  if [ ! -d "$WF/tasks" ]; then issue WARNING "$WF/tasks" 1 'tasks directory is missing' 'Run: workflow init'; fi
  collect_tasks; validate_required_fields; validate_task_types; validate_efforts; validate_layout; validate_collisions
  validate_blockers; validate_bases; validate_cycles; validate_decisions; validate_line_endings
}
while [ $# -gt 0 ]; do
  case $1 in
    --help|-h) usage; exit 0 ;;
    --fix) FIX=1; shift ;;
    --strict) STRICT=1; shift ;;
    --no-color) C_RED= C_YELLOW= C_BLUE= C_OFF=; shift ;;
    --format) if [ $# -lt 2 ]; then printf 'Error: --format requires text or json\n' >&2; exit 2; fi; FORMAT=$2; shift 2 ;;
    --format=*) FORMAT=${1#--format=}; shift ;;
    *) printf 'Error: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
if [[ "$FORMAT" != text && "$FORMAT" != json ]]; then printf 'Error: invalid format: %s\n' "$FORMAT" >&2; exit 2; fi
run_validation
if [ "$FIX" = 1 ] && [ "${#FIX_FILES[@]}" -gt 0 ]; then apply_fixes; run_validation; fi
STATUS=0
if [ "$ERRORS" -gt 0 ] || { [ "$STRICT" = 1 ] && [ "$WARNINGS" -gt 0 ]; }; then STATUS=2
elif [ "$WARNINGS" -gt 0 ]; then STATUS=1; fi
if [ "$FORMAT" = json ]; then
  printf '{"valid":%s,"errors":%d,"warnings":%d,"tasks":%d,"issues":[' "$([ "$STATUS" = 0 ] && printf true || printf false)" "$ERRORS" "$WARNINGS" "${#FILES[@]}"
  separator=
  for report in "${ISSUES[@]}"; do
    IFS=$'\t' read -r kind file line message suggestion <<< "$report"
    printf '%s{"severity":%s,"file":%s,"line":%s,"message":%s,"suggestion":%s}' "$separator" "$(json_string "$kind")" "$(json_string "$file")" "$line" "$(json_string "$message")" "$(json_string "$suggestion")"
    separator=,
  done
  printf ']}\n'
else
  for report in "${ISSUES[@]}"; do
    IFS=$'\t' read -r kind file line message suggestion <<< "$report"
    color=$C_RED; [ "$kind" = WARNING ] && color=$C_YELLOW
    label=Error; [ "$kind" = WARNING ] && label=Warning
    printf '%s%s:%s %s:%s: %s\n  Fix: %s\n' "$color" "$label" "$C_OFF" "$file" "$line" "$message" "$suggestion" >&2
  done
  if [ "$STATUS" = 0 ]; then printf '%sWorkflow is valid (%d task files).%s\n' "$C_BLUE" "${#FILES[@]}" "$C_OFF"
  else printf '%d error(s), %d warning(s).\n' "$ERRORS" "$WARNINGS"; fi
fi
exit "$STATUS"
