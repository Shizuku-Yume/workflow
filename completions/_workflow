#compdef workflow workflow-tasks workflow-deps workflow-decisions workflow-effort workflow-debt workflow-hotfix-review workflow-validate workflow-next

_workflow_completion_efforts() {
  local root=$PWD file slug
  local -a slugs
  while [[ $root != / && ! -d $root/.workflow ]]; do root=${root:h}; done
  for file in "$root"/.workflow/efforts/*.md(N); do
    [[ -f $file ]] || continue
    slug=${file:t:r}
    [[ $slug =~ '^[a-z0-9]+(-[a-z0-9]+)*$' ]] && slugs+=("$slug")
  done
  (( ${#slugs} )) && compadd -- "${slugs[@]}"
}

_workflow_completion_formats() {
  _values 'format' "${formats[@]}"
}

_workflow_completion_fields() {
  _values 'field' Decided 'Instead of' Because Mine 'Revisit when' Date Title
}

_workflow_completion_description() {
  _values 'standard input' '-[read from stdin]'
  _files
}

_workflow() {
  local -a words=("${words[@]}") common specs formats positionals
  local CURRENT=$CURRENT command=${words[1]:t} action= word skip=0 i
  if [[ $command == workflow ]]; then
    if (( CURRENT == 2 )); then
      _arguments '(-h --help)'{-h,--help}'[show help]' '(-v --version)'{-v,--version}'[show version]' \
        '1:command:(init update doctor uninstall hook version tasks deps decisions effort debt hotfix-review validate next help)'
      return
    fi
    words=("${words[@]:1}")
    (( CURRENT-- ))
    command=${words[1]}
  else
    command=${command#workflow-}
  fi

  # Find the action without mistaking an option's value for a subcommand.
  for (( i=2; i<CURRENT; i++ )); do
    word=${words[i]}
    if (( skip )); then skip=0; continue; fi
    case $word in
      --format|--effort|--after|--before|--field|--priority|--title|--id|--location|--description-file|--problem|--impact|--solution|--cost|--resolution|--commit|--pr|--reason|--mark-resolved)
        skip=1 ;;
      -*) ;;
      *) positionals+=("$word") ;;
    esac
  done
  action=${positionals[1]:-}
  common=('(-h --help)-h[show help]' '(-h --help)--help[show help]' '--no-color[disable colors]')
  formats=(text json)
  case $command in
    tasks)
      specs=(
        '(--ready)--blocked[show only blocked tasks]'
        '(--blocked)--ready[show only ready tasks]'
        '--effort[filter by effort]:effort slug:_workflow_completion_efforts'
        '--status[show counts for selected tasks]'
        '--format[output format]:format:_workflow_completion_formats'
      ) ;;
    deps)
      formats=(mermaid dot text)
      specs=(
        '--format[output format]:format:_workflow_completion_formats'
        '--effort[filter effort and transitive blockers]:effort slug:_workflow_completion_efforts'
        '--all[include completed tasks]'
        '--check[validate dependencies only]'
      ) ;;
    decisions)
      specs=(
        '--after[include decisions on or after date]:date:'
        '--before[include decisions on or before date]:date:'
        '--effort[include only entries tagged with this effort]:effort slug:_workflow_completion_efforts'
        '--format[output format]:format:_workflow_completion_formats'
      )
      case $action in
        '') specs+=('1:command:(list search recent validate)' '--fix[preview safe formatting repairs]' '--apply[apply repairs]') ;;
        search) specs+=('1:command:(search)' '2:search term:' '--field[search only this field]:field:_workflow_completion_fields') ;;
        recent) specs+=('1:command:(recent)' '2:number of entries:') ;;
        *) specs+=('1:command:(list validate)' '--fix[preview safe formatting repairs]' '--apply[apply repairs]') ;;
      esac ;;
    effort)
      case $action in
        '') specs=('1:command:(list status create rename complete)' '--archived[include completed efforts in list]') ;;
        list) specs=('1:command:(list)' '--archived[include completed efforts in list]') ;;
        status|complete) specs=("1:command:($action)" '2:effort slug:_workflow_completion_efforts') ;;
        rename) specs=('1:command:(rename)' '2:old effort slug:_workflow_completion_efforts' '3:new effort slug:') ;;
        create) specs=('1:command:(create)' '2:new effort slug:') ;;
      esac ;;
    debt)
      case $action in
        '') specs=('1:command:(init list add resolve accept)') ;;
        list)
          specs=(
            '1:command:(list)'
            '--priority[filter priority]:priority:(fix-now worth-doing only-if-grows)'
            '--by-file[group by location]'
            '--age[show elapsed days]'
            '--format[output format]:format:_workflow_completion_formats'
          ) ;;
        add)
          specs=(
            '1:command:(add)' '--title[debt title]:title:' '--id[item ID]:ID:'
            '--location[location paths]:paths:'
            '--priority[debt priority]:priority:(fix-now worth-doing only-if-grows)'
            '(--problem)--description-file[read problem text from file]:file:_workflow_completion_description'
            '(--description-file)--problem[problem text]:text:'
            '--impact[impact text]:text:' '--solution[solution text]:text:' '--cost[cost text]:text:'
          ) ;;
        resolve|resolved)
          specs=("1:command:($action)" '2:debt ID:' '--resolution[resolution text]:text:' '--commit[commit SHA]:SHA:' '--pr[PR number or URL]:PR:') ;;
        accept|accepted)
          specs=("1:command:($action)" '2:debt ID:' '--reason[acceptance reason]:text:') ;;
        init) specs=('1:command:(init)') ;;
      esac ;;
    hotfix-review)
      specs=(
        '--all[include resolved entries]'
        '--mark-resolved[mark an entry resolved]:entry ID:'
        '--format[output format]:format:_workflow_completion_formats'
      ) ;;
    validate)
      specs=(
        '--fix[ask before converting CRLF to LF]'
        '--strict[treat warnings as errors]'
        '--format[output format]:format:_workflow_completion_formats'
      ) ;;
    next)
      specs=('--interactive[select a task]' '--format[output format]:format:_workflow_completion_formats') ;;
    init|update)
      common=('(-h --help)-h[show help]' '(-h --help)--help[show help]')
      specs=('--force[replace existing installation files]'
        '(--no-claude)--claude[also install .claude/ skills, agents and CLAUDE.md]'
        '(--claude)--no-claude[do not install the Claude Code adapter]') ;;
    hook)
      common=('(-h --help)-h[show help]' '(-h --help)--help[show help]')
      specs=('1:action:(install uninstall status)' '--force[replace an existing pre-commit hook]') ;;
    doctor|uninstall|version|help)
      common=('(-h --help)-h[show help]' '(-h --help)--help[show help]') ;;
    *) return 1 ;;
  esac
  _arguments "${common[@]}" "${specs[@]}"
}

# compinit autoloads this file; direct sourcing can also register the function.
if [[ $ZSH_EVAL_CONTEXT == *:file ]]; then
  if (( $+functions[compdef] )); then
    compdef _workflow workflow workflow-tasks workflow-deps workflow-decisions workflow-effort workflow-debt workflow-hotfix-review workflow-validate workflow-next
  fi
else
  _workflow "$@"
fi
